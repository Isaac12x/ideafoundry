#!/usr/bin/env bash

# Online backup for SQLite databases and local Active Storage files.
# SQLite is copied with VACUUM INTO, which is safe while the app is serving
# requests. Active Storage files are archived from storage/ so uploaded data is
# backed up with the same care as the database.
# Usage: bin/backup [destination_dir]

set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BACKUP_DIR="${1:-${APP_DIR}/backups}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

mkdir -p "$BACKUP_DIR"

for db in storage/production.sqlite3 storage/queue.sqlite3; do
  src="${APP_DIR}/${db}"
  [ -f "$src" ] || continue

  name=$(basename "$db" .sqlite3)
  dest="${BACKUP_DIR}/${name}_${TIMESTAMP}.sqlite3"

  sqlite3 "$src" "VACUUM INTO '${dest}';"
  echo "Backed up ${db} → ${dest}"
done

files_dest="${BACKUP_DIR}/active_storage_${TIMESTAMP}.tar.gz"
tar -czf "$files_dest" \
  -C "${APP_DIR}/storage" \
  --exclude='*.sqlite3*' \
  --exclude='recovery_passphrase.key' \
  .
echo "Backed up Active Storage files → ${files_dest}"

# Prune backups older than 7 days
find "$BACKUP_DIR" \( -name "*.sqlite3" -o -name "active_storage_*.tar.gz" \) -mtime +7 -delete 2>/dev/null || true
echo "Backup complete. Pruned files older than 7 days."
