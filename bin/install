#!/bin/zsh
set -e

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$APP_DIR/bin/idea_app_installation"
INSTALLATION_NAME="$(idea_app_installation_name "$@")" || exit $?
RUBY_VERSION=$(cat "$APP_DIR/.ruby-version")
USERNAME=$(whoami)
HOMEDIR=$HOME
PLIST_LABEL="com.${USERNAME}.${INSTALLATION_NAME}"
PLIST_NAME="${PLIST_LABEL}.plist"
PLIST_DEST="$HOMEDIR/Library/LaunchAgents/$PLIST_NAME"
APP_PORT="${PORT:-$(idea_app_default_port "$INSTALLATION_NAME" app)}"
VOICE_ID_HOST_PORT="${VOICE_ID_PORT:-$(idea_app_default_port "$INSTALLATION_NAME" voice_id)}"
OCR_SERVICE_HOST_PORT="${OCR_SERVICE_PORT:-$(idea_app_default_port "$INSTALLATION_NAME" ocr)}"
HTTPS_PORT="${IDEA_APP_HTTPS_PORT:-$(idea_app_default_port "$INSTALLATION_NAME" https)}"
CADDY_HTTP_PORT="${IDEA_APP_CADDY_HTTP_PORT:-$(idea_app_default_port "$INSTALLATION_NAME" caddy_http)}"
CADDY_ADMIN_PORT="${IDEA_APP_CADDY_ADMIN_PORT:-$(idea_app_default_port "$INSTALLATION_NAME" caddy_admin)}"
SKIP_CADDY="${IDEA_APP_SKIP_CADDY:-$(idea_app_default_skip_caddy "$INSTALLATION_NAME")}"

echo "==> Idea Foundry installer"
echo "    Installation: $INSTALLATION_NAME | User: $USERNAME | Ruby: $RUBY_VERSION | App: $APP_DIR"
echo "    Ports: Rails $APP_PORT | Voice ID $VOICE_ID_HOST_PORT | OCR $OCR_SERVICE_HOST_PORT | HTTPS $HTTPS_PORT"

# --- Homebrew ---
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

# --- rbenv ---
if ! command -v rbenv &>/dev/null; then
  echo "==> Installing rbenv + ruby-build..."
  brew install rbenv ruby-build
fi
eval "$(rbenv init - zsh)"

# --- Ruby ---
if ! rbenv versions --bare | grep -qx "$RUBY_VERSION"; then
  echo "==> Installing Ruby $RUBY_VERSION (this takes a few minutes)..."
  rbenv install "$RUBY_VERSION"
fi
rbenv local "$RUBY_VERSION"

# --- Node.js (for esbuild/JS bundle) ---
if ! command -v node &>/dev/null; then
  echo "==> Installing Node.js..."
  brew install node
fi

# --- Local media editing toolchain ---
typeset -A MEDIA_PACKAGES=(
  ffmpeg ffmpeg
  magick imagemagick
  gs ghostscript
  pdftk pdftk-java
  pdfinfo poppler
)
for command package in ${(kv)MEDIA_PACKAGES}; do
  if ! command -v "$command" &>/dev/null; then
    echo "==> Installing media editor dependency: $package..."
    brew install "$package"
  fi
done

# --- Caddy ---
if ! command -v caddy &>/dev/null; then
  echo "==> Installing Caddy..."
  brew install caddy
fi

# --- Disable macOS built-in Apache httpd ---
if launchctl list 2>/dev/null | grep -q "org.apache.httpd"; then
  echo "==> Disabling built-in Apache httpd..."
  sudo launchctl unload -w /System/Library/LaunchDaemons/org.apache.httpd.plist 2>/dev/null || true
fi
if pgrep -x httpd &>/dev/null; then
  echo "==> Stopping running httpd..."
  sudo apachectl stop 2>/dev/null || true
fi

# --- /etc/hosts entry for ideas.local ---
if ! grep -q "ideas.local" /etc/hosts; then
  echo "==> Adding ideas.local to /etc/hosts..."
  echo "127.0.0.1 ideas.local" | sudo tee -a /etc/hosts >/dev/null
fi

# --- Bundler + gems ---
echo "==> Installing gems..."
if ! command -v bundle >/dev/null 2>&1; then
  gem install bundler --no-document
fi
bundle install --jobs 4

# --- Node modules (esbuild, 3D graph) ---
if [ -f "$APP_DIR/package.json" ]; then
  echo "==> Installing Node dependencies..."
  npm install --prefix "$APP_DIR"
fi

# --- Generate SECRET_KEY_BASE if not already set ---
SECRET_FILE="$APP_DIR/.secret_key_base"
if [ -f "$SECRET_FILE" ]; then
  SECRET_KEY_BASE=$(cat "$SECRET_FILE")
else
  SECRET_KEY_BASE=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(64)')
  echo "$SECRET_KEY_BASE" > "$SECRET_FILE"
fi

# --- Unload this installation's old plist if running ---
if launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1; then
  echo "==> Stopping existing service..."
  launchctl bootout "gui/$(id -u)/$PLIST_LABEL" 2>/dev/null || \
    launchctl unload "$PLIST_DEST" 2>/dev/null || true
fi

# --- Generate plist from template ---
echo "==> Installing LaunchAgent → $PLIST_DEST"
sed -e "s|__USERNAME__|${USERNAME}|g" \
    -e "s|__INSTALLATION_NAME__|${INSTALLATION_NAME}|g" \
    -e "s|__APPDIR__|${APP_DIR}|g" \
    -e "s|__HOMEDIR__|${HOMEDIR}|g" \
    -e "s|__PORT__|${APP_PORT}|g" \
    -e "s|__VOICE_ID_PORT__|${VOICE_ID_HOST_PORT}|g" \
    -e "s|__OCR_SERVICE_PORT__|${OCR_SERVICE_HOST_PORT}|g" \
    -e "s|__HTTPS_PORT__|${HTTPS_PORT}|g" \
    -e "s|__CADDY_HTTP_PORT__|${CADDY_HTTP_PORT}|g" \
    -e "s|__CADDY_ADMIN_PORT__|${CADDY_ADMIN_PORT}|g" \
    -e "s|__SKIP_CADDY__|${SKIP_CADDY}|g" \
    -e "s|__SECRET_KEY_BASE__|${SECRET_KEY_BASE}|g" \
    "$APP_DIR/com.USERNAME.idea-app.plist" > "$PLIST_DEST"

# --- DB setup ---
echo "==> Preparing database..."
SECRET_KEY_BASE="$SECRET_KEY_BASE" RAILS_ENV=production bin/rails db:prepare_if_unlocked

# --- Asset precompile ---
echo "==> Precompiling assets..."
SECRET_KEY_BASE="$SECRET_KEY_BASE" RAILS_ENV=production bin/rails assets:precompile

# --- Load + start ---
echo "==> Starting service..."
launchctl load -w "$PLIST_DEST"

echo ""
echo "==> Done! Idea Foundry installation '$INSTALLATION_NAME' is running."
echo "    Service: $PLIST_NAME"
echo "    Logs:    /tmp/${INSTALLATION_NAME}.out & /tmp/${INSTALLATION_NAME}.err"
echo "    URL:     https://ideas.local:${HTTPS_PORT}"
