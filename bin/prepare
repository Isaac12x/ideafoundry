#!/usr/bin/env sh
# Shared startup prepare for dev: JS deps, JS + Excalidraw build, migrations.
# Production-style entry points get the same via `assets:precompile` (jsbundling
# runs yarn install + yarn build) and `db:prepare_if_unlocked`. SKIP_PREPARE=1 opts out.
set -e
[ -n "$SKIP_PREPARE" ] && exit 0
cd "$(dirname "$0")/.."

fail() { echo "bin/prepare FAILED at: $1. Not starting a half-prepared app." >&2; exit 1; }

# ponytail: yarn's own integrity check is ~0.1s; build is ~2s, so always rebuild rather than track sources.
yarn check --integrity >/dev/null 2>&1 || yarn install --frozen-lockfile || fail "yarn install"
log="$(mktemp)"
yarn build >"$log" 2>&1 || { cat "$log"; fail "yarn build"; }
rm -f "$log"
bin/rails db:prepare_if_unlocked || fail "db:prepare"
