#!/bin/zsh

# Shared installation-name parsing for bin/install and bin/start_idea_app.sh.
# Compose project names only accept lowercase letters, digits, dashes, and
# underscores, and must begin with a letter or digit.
idea_app_installation_name() {
  if (( $# > 1 )); then
    echo "Usage: $0 [installation-name]" >&2
    return 64
  fi

  if (( $# == 1 )) && [[ -z "$1" ]]; then
    echo "Installation name cannot be empty." >&2
    return 64
  fi

  local installation_name
  if (( $# == 1 )); then
    installation_name="$1"
  else
    installation_name="${IDEA_APP_INSTALLATION_NAME:-idea-app}"
  fi

  if [[ ! "$installation_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Invalid installation name: $installation_name" >&2
    echo "Use lowercase letters, digits, dashes, or underscores; begin with a letter or digit." >&2
    return 64
  fi

  if (( ${#installation_name} > 63 )); then
    echo "Installation name is too long: use at most 63 characters." >&2
    return 64
  fi

  print -r -- "$installation_name"
}

# Named installations receive a stable port slot so the name alone is enough
# to keep Rails, sidecars, and the local Caddy proxy off another install's
# listeners. Explicit environment variables can still override every port.
idea_app_port_slot() {
  local installation_name="$1"
  local checksum_output checksum

  checksum_output="$(print -rn -- "$installation_name" | cksum)"
  checksum="${checksum_output%% *}"
  print -r -- "$((checksum % 8000))"
}

idea_app_default_port() {
  local installation_name="$1"
  local service="$2"

  if [[ "$installation_name" == "idea-app" ]]; then
    case "$service" in
      app) print -r -- 3333 ;;
      voice_id) print -r -- 8000 ;;
      ocr) print -r -- 8001 ;;
      https) print -r -- 8443 ;;
      caddy_http) print -r -- 8080 ;;
      caddy_admin) print -r -- 2019 ;;
      *) echo "Unknown Idea Foundry service port: $service" >&2; return 64 ;;
    esac
    return 0
  fi

  local slot="$(idea_app_port_slot "$installation_name")"
  local base
  case "$service" in
    app) base=10000 ;;
    voice_id) base=18000 ;;
    ocr) base=26000 ;;
    https) base=34000 ;;
    caddy_http) base=42000 ;;
    caddy_admin) base=50000 ;;
    *) echo "Unknown Idea Foundry service port: $service" >&2; return 64 ;;
  esac

  print -r -- "$((base + slot))"
}

idea_app_default_skip_caddy() {
  if [[ "$1" == "idea-app" ]]; then
    print -r -- 1
  else
    print -r -- 0
  fi
}
