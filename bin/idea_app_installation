#!/bin/zsh

# Shared installation-name parsing for bin/install and bin/start_idea_app.sh.
# Compose project names only accept lowercase letters, digits, dashes, and
# underscores, and must begin with a letter or digit.
idea_app_installation_name() {
  if (( $# > 1 )); then
    echo "Usage: $0 [installation-name]" >&2
    return 64
  fi

  local installation_name="${1:-${IDEA_APP_INSTALLATION_NAME:-idea-app}}"

  if [[ ! "$installation_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Invalid installation name: $installation_name" >&2
    echo "Use lowercase letters, digits, dashes, or underscores; begin with a letter or digit." >&2
    return 64
  fi

  print -r -- "$installation_name"
}
