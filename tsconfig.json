{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./app/assets/builds",
    "baseUrl": ".",
    "paths": {
      "*": ["app/javascript/*"]
    }
  },
  "include": ["app/javascript/**/*"]
}
