<div class="kb-fact-card" id="<%= dom_id(problem) %>">
  <p class="kb-fact-body"><strong><%= problem.title %></strong></p>
  <% if problem.need.present? %><p class="kb-fact-body"><%= problem.need %></p><% end %>
  <p class="kb-fact-time" data-problem-status="<%= problem.status %>">
    <% if problem.busy? %>Looking on Wikipedia and Grokipedia...<% elsif problem.status == "failed" %>Lookup failed: <%= problem.result %><% else %><%= problem.result %><% end %>
  </p>
  <div class="kb-fact-meta">
    <span class="kb-fact-time">
      <% native = KbSource.list(problem.user).index { |s| s[:native] } %>
      <% if native && File.directory?(problem.abs_dir) %><%= link_to "Open in KB", kb_path(src: native, file: "#{problem.folder}/problem.md") %> · <% end %>
      <%= time_ago_in_words(problem.created_at) %> ago
    </span>
    <span>
      <%= button_to "Find on Wikipedia/Grokipedia", find_problem_path(problem), class: "btn btn-sm", disabled: problem.busy?, form_class: "kb-inline-form", form: { style: "display:inline" } %>
      <%= button_to problem_path(problem), method: :delete, class: "kb-fact-delete", title: "Remove problem (KB files stay)", "aria-label": "Remove problem",
            form: { data: { turbo_confirm: "Remove this problem? Its KB files stay." } } do %>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      <% end %>
    </span>
  </div>
  <% ideas = problem.user.ideas.order(:title).limit(200) %>
  <% linked = problem.idea_links.includes(:idea).map(&:idea) %>
  <% if linked.any? %><p class="kb-fact-time">Ideas: <%= safe_join(linked.map { |i| link_to(i.title, idea_path(i)) }, ", ") %></p><% end %>
  <%= form_with url: link_problem_path(problem), class: "kb-inline-form" do |f| %>
    <%= f.select :idea_id, ideas.map { |i| [ i.title, i.id ] }, { include_blank: "Link to idea..." }, required: true, "aria-label": "Link to idea" %>
    <%= f.submit "Link", class: "btn btn-sm" %>
  <% end %>
</div>
