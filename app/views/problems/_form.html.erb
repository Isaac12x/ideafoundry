<div class="kb-fact-form-wrap" id="problem_form">
  <% error ||= nil; problem ||= nil %>
  <%= form_with url: problems_path, scope: :problem, data: { controller: "fact-form", action: "turbo:submit-end->fact-form#afterSubmit", fact_form_refocus_value: refocus ||= false } do |f| %>
    <% if error %>
      <div class="alert alert-error" style="margin-bottom: 0.75rem; padding: 0.5rem 0.75rem; font-size: 0.85rem;"><%= error %></div>
    <% end %>
    <div class="kb-fact-input-row">
      <%= f.text_field :title, placeholder: "The problem, e.g. Slippery train tracks", class: "kb-fact-textarea", required: true, value: problem&.title, "aria-label": "Problem" %>
      <%= f.text_area :need, placeholder: "The need: who suffers, and what would solving it change?", class: "kb-fact-textarea", rows: 3, value: problem&.need, "aria-label": "Need" %>
      <div class="kb-fact-actions"><%= f.submit "Add problem", class: "btn btn-primary btn-sm" %></div>
    </div>
  <% end %>
</div>
