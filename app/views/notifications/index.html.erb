<% back = notifications_path(kind: @kind) %>
<turbo-frame id="inbox_panel" class="inbox-frame">
  <div class="inbox-head">
    <nav class="inbox-tabs" aria-label="Inbox scope">
      <% { "all" => "All", "general" => "General", "idea" => "Ideas", "project" => "Projects" }.each do |kind, label| %>
        <%= link_to label, notifications_path(kind: kind), class: "inbox-tab#{' is-active' if @kind == kind}", aria: { current: (@kind == kind ? "true" : nil) } %>
      <% end %>
    </nav>
    <%= button_to "Mark all read", read_all_notifications_path(return_to: back), method: :post, class: "inbox-link", form_class: "inbox-inline" %>
  </div>

  <ul class="inbox-list">
    <% @drafts.each do |idea| %><%= render "notifications/draft", idea: idea, return_to: back %><% end %>
    <% @notifications.each do |n| %><%= render "notifications/notification", notification: n, return_to: back, show_scope: true %><% end %>
  </ul>
  <% if @drafts.empty? && @notifications.empty? %><p class="inbox-empty">Nothing new.</p><% end %>

  <h3 class="inbox-section">Tasks</h3>
  <ul class="inbox-list">
    <% @tasks.each do |t| %><%= render "notifications/task", task: t, return_to: back, show_scope: true %><% end %>
  </ul>
  <% if @tasks.empty? %><p class="inbox-empty">No open tasks.</p><% end %>
  <%= render "notifications/task_form", scope: :general, return_to: back %>
</turbo-frame>
