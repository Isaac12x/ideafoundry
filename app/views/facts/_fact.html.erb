<div class="kb-fact-card" id="<%= dom_id(fact) %>">
  <p class="kb-fact-body"><%= fact.body %></p>
  <div class="kb-fact-meta">
    <span class="kb-fact-time"><%= time_ago_in_words(fact.created_at) %> ago</span>
    <%= button_to fact_path(fact),
          method: :delete,
          class: "kb-fact-delete",
          title: "Delete",
          form: { data: { turbo_confirm: "Delete this fact?" } } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    <% end %>
  </div>
</div>
