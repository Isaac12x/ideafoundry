<dialog class="command-palette"
        data-controller="command-palette"
        data-command-palette-search-url-value="<%= global_search_path %>"
        data-action="click->command-palette#backdropClick cancel->command-palette#onCancel"
        aria-labelledby="command_palette_title">
  <div class="command-palette__frame">
    <div class="command-palette__header">
      <h2 id="command_palette_title">Search</h2>
      <kbd data-command-palette-target="key">Ctrl/Cmd+K</kbd>
    </div>
    <input type="search"
           aria-label="Search"
           class="command-palette__input"
           placeholder="Search or jump to..."
           autocomplete="off"
           data-command-palette-target="input"
           data-action="input->command-palette#search keydown->command-palette#navigate">
    <div class="command-palette__results" data-command-palette-target="results"></div>
  </div>
</dialog>
