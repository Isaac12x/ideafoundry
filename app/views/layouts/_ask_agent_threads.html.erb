<% thread_param = local_assigns[:thread_param].to_s %>
<% active_thread = ask_agent_active_thread(thread_param) %>
<% turns = ask_agent_question_threads(active_thread, thread_param) %>
<% thread_list = @user ? @user.agent_threads.recent.limit(30).to_a : [] %>
<% has_legacy = @user&.agent_events&.where(event_type: "question", agent_thread_id: nil)&.exists? %>
<% active_key = active_thread ? active_thread.id.to_s : (thread_param == "new" || turns.empty? ? "new" : "legacy") %>
<div class="ask-agent-threadbar" data-active-thread="<%= active_key == "legacy" ? "new" : active_key %>">
  <details class="ask-agent-threadbar__menu">
    <summary>
      <span class="ask-agent-threadbar__title"><%= active_thread&.title.presence || (active_key == "legacy" ? "Earlier questions" : "New thread") %></span>
      <span class="ask-agent-threadbar__count"><%= pluralize(turns.size, "turn") %></span>
    </summary>
    <ul class="ask-agent-threadbar__list">
      <% thread_list.each do |item| %>
        <li>
          <button type="button" data-action="ask-agent#selectThread" data-thread-id="<%= item.id %>" aria-current="<%= item == active_thread %>">
            <span><%= item.title.presence || "Untitled" %></span>
            <time><%= time_ago_in_words(item.updated_at) %> ago</time>
          </button>
        </li>
      <% end %>
      <% if has_legacy %>
        <li>
          <button type="button" data-action="ask-agent#selectThread" data-thread-id="legacy" aria-current="<%= active_key == "legacy" %>">
            <span>Earlier questions</span>
          </button>
        </li>
      <% end %>
      <% if thread_list.empty? && !has_legacy %>
        <li class="ask-agent-threadbar__none">No threads yet.</li>
      <% end %>
    </ul>
  </details>
  <button type="button" class="ask-agent-threadbar__new" data-action="ask-agent#newThread">New thread</button>
</div>

<% if turns.any? %>
  <% turns.each do |thread| %>
    <% question = thread[:question] %>
    <% answer = thread[:answer] %>
    <% asked_to = LocalAgent::Agents.label(question.payload&.dig("agent")) %>
    <article class="ask-agent-thread">
      <div class="ask-agent-message ask-agent-message--user">
        <div class="ask-agent-message__meta">
          <span>You <em>to <%= asked_to %></em></span>
          <time><%= time_ago_in_words(question.created_at) %> ago</time>
        </div>
        <p><%= question.payload&.dig("question").presence || question.summary %></p>
      </div>

      <% if thread[:activity].any? %>
        <details class="ask-agent-activity">
          <summary>Activity <span><%= thread[:activity].size %></span></summary>
          <ol>
            <% thread[:activity].each do |event| %>
              <li>
                <code><%= event.event_type %></code>
                <span><%= event.summary %></span>
                <time><%= time_ago_in_words(event.created_at) %> ago</time>
              </li>
            <% end %>
          </ol>
        </details>
      <% end %>

      <% if answer %>
        <% failed = answer.payload&.dig("error") == true %>
        <div class="ask-agent-message ask-agent-message--agent<%= " ask-agent-message--error" if failed %>">
          <div class="ask-agent-message__meta">
            <span><%= failed ? "Failed" : LocalAgent::Agents.label(answer.payload&.dig("agent")) %></span>
            <time><%= time_ago_in_words(answer.created_at) %> ago</time>
          </div>
          <% if failed %>
          <p><%= answer.payload&.dig("answer").presence || answer.summary %></p>
        <% else %>
          <%= render_prose(link_patent_notes(answer.payload&.dig("answer").presence || answer.summary)) %>
        <% end %>
        </div>
      <% else %>
        <div class="ask-agent-message ask-agent-message--pending" aria-busy="true">
          <div class="ask-agent-message__meta">
            <span><%= asked_to %></span>
            <time>Pending</time>
          </div>
          <p><span class="ask-agent-working" aria-hidden="true"><i></i><i></i><i></i></span><span class="<%= "ask-agent-pending-note" if question.created_at >= 10.minutes.ago %>"><%= question.created_at < 10.minutes.ago ? "No answer yet. The agent may not be running or may have failed." : "Waiting for an answer." %></span></p>
        </div>
      <% end %>
    </article>
  <% end %>
<% else %>
  <div class="ask-agent-sidebar__empty">
    <p class="ask-agent-sidebar__empty-title">What can I help you think through?</p>
    <div class="ask-agent-suggestions">
      <% [ "What should I focus on next?", "Summarize this and list the open questions", "What are the biggest risks?", "Suggest three concrete next steps" ].each do |text| %>
        <button type="button" class="ask-agent-suggestion" data-action="ask-agent#suggest" data-text="<%= text %>"><%= text %></button>
      <% end %>
    </div>
  </div>
<% end %>
