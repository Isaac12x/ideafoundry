<% if notice %>
  <div class="alert alert-success" role="status" data-controller="flash" data-action="click->flash#dismiss"><%= notice %></div>
<% end %>
<% if notice == nil && params[:upgraded].present? %>
  <div class="alert alert-success" role="status" data-controller="flash" data-action="click->flash#dismiss">App upgraded successfully.</div>
<% end %>
<% if alert %>
  <div class="alert alert-error" role="alert" data-controller="flash" data-flash-auto-value="false" data-action="click->flash#dismiss"><%= alert %></div>
<% end %>
