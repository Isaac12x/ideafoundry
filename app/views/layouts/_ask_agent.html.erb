<div class="ask-agent-shell" data-controller="ask-agent">
  <button type="button"
          class="nav-pill nav-ask-agent-button"
          data-action="click->ask-agent#open"
          aria-haspopup="dialog">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 3a6 6 0 016 6v2a6 6 0 01-12 0V9a6 6 0 016-6z"/>
      <path d="M8 15v2a4 4 0 008 0v-2"/>
      <path d="M9 9h.01M15 9h.01M10 12h4"/>
    </svg>
    Ask Agent
  </button>

  <dialog class="ask-agent-modal"
          data-ask-agent-target="dialog"
          data-action="click->ask-agent#closeOnBackdrop cancel->ask-agent#close"
          aria-labelledby="ask_agent_title">
    <div class="ask-agent-modal__inner">
      <header class="ask-agent-modal__header">
        <h2 id="ask_agent_title">Ask Agent</h2>
        <button type="button"
                class="ask-agent-modal__close"
                data-action="click->ask-agent#close"
                aria-label="Close Ask Agent">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </header>

      <%= form_with url: settings_local_agent_questions_path, method: :post, local: true, class: "ask-agent-modal__form" do %>
        <%= hidden_field_tag :return_to, request.fullpath %>
        <div class="form-group">
          <%= label_tag "global_agent_question_body", "Question" %>
          <%= text_area_tag "agent_question[body]",
                nil,
                id: "global_agent_question_body",
                rows: 5,
                class: "form-control",
                placeholder: "What should I focus on next?",
                required: true,
                data: { ask_agent_target: "body" } %>
        </div>
        <div class="ask-agent-modal__actions">
          <%= submit_tag "Ask Agent", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
