<div class="activity-panel" data-activity-panel-target="panel">
  <div class="activity-panel__backdrop"
       data-action="click->activity-panel#close"
       aria-hidden="true"></div>

  <div class="activity-panel__drawer" role="dialog" aria-label="Activity log" aria-modal="true">
    <div class="activity-panel__header">
      <div class="activity-panel__title">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        Activity
      </div>
      <button class="activity-panel__close"
              data-action="click->activity-panel#close"
              aria-label="Close activity panel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="activity-panel__body">
      <turbo-frame id="activity_panel"
                   data-activity-panel-target="frame"
                   data-activity-panel-url="<%= settings_activity_path %>">
        <div class="activity-panel__loading">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="activity-panel__spinner">
            <path d="M21 12a9 9 0 11-6.219-8.56"/>
          </svg>
        </div>
      </turbo-frame>
    </div>
  </div>
</div>
