<div class="settings-container">
  <div class="page-header">
    <h2>API Keys</h2>
    <%= link_to settings_path, class: "btn btn-sm" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back
    <% end %>
  </div>

  <% if flash[:api_token].present? %>
    <div class="alert alert-success">
      <strong>New API key created.</strong> Copy this token now — it won't be shown again:
      <div class="token-display">
        <code><%= flash[:api_token] %></code>
      </div>
    </div>
  <% end %>

  <div class="settings-section">
    <h3>Create New Key</h3>
    <%= form_with url: settings_api_keys_path, method: :post, class: "api-key-form" do |form| %>
      <div class="form-row">
        <div class="form-group" style="flex: 1;">
          <%= form.label :name, "Key Name" %>
          <%= form.text_field :name, class: "form-control", placeholder: "e.g. Zapier, n8n, CLI script...", required: true %>
        </div>
        <%= form.submit "Create Key", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="settings-section">
    <h3>Existing Keys</h3>
    <% if @api_keys.any? %>
      <div class="api-keys-list">
        <% @api_keys.each do |key| %>
          <div class="api-key-row">
            <div class="api-key-info">
              <span class="api-key-name"><%= key.name %></span>
              <span class="api-key-meta">
                Created <%= time_ago_in_words(key.created_at) %> ago
                <% if key.last_used_at.present? %>
                  &middot; Last used <%= time_ago_in_words(key.last_used_at) %> ago
                <% else %>
                  &middot; Never used
                <% end %>
                <% unless key.active? %>
                  &middot; <span style="color: var(--danger);">Inactive</span>
                <% end %>
              </span>
            </div>
            <%= button_to settings_api_key_destroy_path(key), method: :delete,
                class: "btn btn-sm btn-danger",
                data: { turbo_confirm: "Delete this API key? Any integrations using it will stop working." } do %>
              Delete
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state-small">
        <p>No API keys yet. Create one to start sending submissions programmatically.</p>
      </div>
    <% end %>
  </div>

  <div class="settings-section">
    <h3>Usage</h3>
    <div class="raw-data-viewer">
      <pre><code>curl -X POST <%= request.base_url %>/api/v1/submissions \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "title": "My Idea",
    "body": "Description of the idea...",
    "source": "curl",
    "priority": "normal",
    "files": [
      {
        "filename": "research.pdf",
        "content_type": "application/pdf",
        "data": "BASE64_ENCODED_DATA"
      }
    ]
  }'</code></pre>
    </div>

    <p style="margin-top: 1rem;">The response includes a human-readable <code>temporary_idea_id</code> like <code>IDEA-TMP-20260323-A1B2</code>.</p>
    <p>Send that same value back on later chat turns to append more context to the same intake item:</p>
    <div class="raw-data-viewer">
      <pre><code>curl -X POST <%= request.base_url %>/api/v1/submissions \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{
    "temporary_idea_id": "IDEA-TMP-20260323-A1B2",
    "body": "More context from the war room chat...",
    "source": "openclaw_gateway"
  }'</code></pre>
    </div>
  </div>
</div>
