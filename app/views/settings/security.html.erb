<%= render 'settings/upgrade_bar' %>
<div class="settings-container">
  <div class="page-header">
    <h2>Security</h2>
    <%= link_to settings_path, class: "btn btn-sm" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Settings
    <% end %>
  </div>

  <div class="typing-settings-layout">
    <div class="typing-settings-main">
      <section class="tab-toggle-section">
        <header class="tab-toggle-section__header">
          <h3>Protection</h3>
          <p>Use local unlock checks and trusted-device uplink pairing for this single-user app.</p>
        </header>

        <%= form_with url: settings_security_path, method: :patch, local: true, class: "typing-settings-form", data: { controller: "settings-autosave", action: "change->settings-autosave#toggleChanged" } do %>
          <label class="tab-toggle" for="typing_lock_enabled">
            <div class="tab-toggle__text">
              <span class="tab-toggle__name">Require typing fingerprint</span>
              <span class="tab-toggle__description">When enabled, the app locks after the inactivity window below.</span>
            </div>
            <span class="tab-toggle__switch">
              <%= check_box_tag "typing_lock[enabled]", "1", @user.typing_lock_enabled?, id: "typing_lock_enabled", class: "tab-toggle__input", data: { privacy_haze_preview_target: "enabled" } %>
              <span class="tab-toggle__track" aria-hidden="true">
                <span class="tab-toggle__thumb"></span>
              </span>
            </span>
          </label>

          <%= hidden_field_tag "authenticator_app[enabled]", "0" %>
          <label class="tab-toggle" for="authenticator_app_enabled">
            <div class="tab-toggle__text">
              <span class="tab-toggle__name">Require authenticator app</span>
              <span class="tab-toggle__description">Ask for a six-digit authenticator code. If typing lock is also enabled, this runs after typing.</span>
            </div>
            <span class="tab-toggle__switch">
              <%= check_box_tag "authenticator_app[enabled]", "1", @user.authenticator_app_enabled?, id: "authenticator_app_enabled", class: "tab-toggle__input" %>
              <span class="tab-toggle__track" aria-hidden="true">
                <span class="tab-toggle__thumb"></span>
              </span>
            </span>
          </label>

          <%= hidden_field_tag "voice_id[enabled]", "0" %>
          <label class="tab-toggle" for="voice_id_enabled">
            <div class="tab-toggle__text">
              <span class="tab-toggle__name">Require Voice ID</span>
              <span class="tab-toggle__description">Unlock with your voice using a passphrase. Runs as the final check each time the workspace reopens.</span>
            </div>
            <span class="tab-toggle__switch">
              <%= check_box_tag "voice_id[enabled]", "1", @user.voice_id_requested?, id: "voice_id_enabled", class: "tab-toggle__input" %>
              <span class="tab-toggle__track" aria-hidden="true">
                <span class="tab-toggle__thumb"></span>
              </span>
            </span>
          </label>

          <%= hidden_field_tag "mobile_uplink[enabled]", "0" %>
          <label class="tab-toggle" for="mobile_uplink_enabled">
            <div class="tab-toggle__text">
              <span class="tab-toggle__name">Mobile Uplink</span>
              <span class="tab-toggle__description">Pair a phone or other device by QR so uploads leave that device through the encrypted uplink path.</span>
            </div>
            <span class="tab-toggle__switch">
              <%= check_box_tag "mobile_uplink[enabled]", "1", @user.mobile_uplink_enabled?, id: "mobile_uplink_enabled", class: "tab-toggle__input" %>
              <span class="tab-toggle__track" aria-hidden="true">
                <span class="tab-toggle__thumb"></span>
              </span>
            </span>
          </label>

          <div class="typing-settings-field">
            <label for="typing_lock_minutes">Lock after</label>
            <div class="typing-settings-number">
              <%= number_field_tag "typing_lock[lock_after_minutes]",
                    @user.typing_lock_timeout_minutes,
                    id: "typing_lock_minutes",
                    min: 1,
                    max: 1440,
                    step: 1,
                    class: "form-control" %>
              <span>minutes</span>
            </div>
          </div>

          <div class="typing-settings-field">
            <label for="typing_lock_failed_unlock_cooldown_minutes">Retry after no match</label>
            <div class="typing-settings-number">
              <%= number_field_tag "typing_lock[failed_unlock_cooldown_minutes]",
                    @user.typing_lock_failed_unlock_cooldown_minutes,
                    id: "typing_lock_failed_unlock_cooldown_minutes",
                    min: 1,
                    max: 1440,
                    step: 1,
                    class: "form-control" %>
              <span>minutes</span>
            </div>
          </div>

        <% end %>
      </section>

      <section class="tab-toggle-section">
        <header class="tab-toggle-section__header">
          <h3>Privacy</h3>
          <p>Use the camera to notice when you look away or when someone else looks. Video never leaves this device.</p>
        </header>

        <% gaze = @privacy_gaze_settings %>
        <div class="privacy-section" data-controller="privacy-haze-preview">
          <%= form_with url: settings_security_privacy_path, method: :patch, local: true, class: "privacy-form", data: { controller: "settings-autosave", action: "change->settings-autosave#toggleChanged input->settings-autosave#echo" } do %>
            <%= hidden_field_tag "privacy_gaze[enabled]", "0", id: nil, data: { privacy_haze_preview_target: "offField" } %>
            <%= hidden_field_tag "privacy_gaze[clear]", "0", id: nil, data: { privacy_haze_preview_target: "clear" } %>
            <label class="tab-toggle" for="privacy_gaze_enabled">
              <div class="tab-toggle__text">
                <span class="tab-toggle__name">Gaze privacy haze</span>
                <span class="tab-toggle__description">When you look away or someone else looks, the page content fades behind a haze. It clears when you look back. If the camera or face ID is unavailable, the haze stays on.</span>
              </div>
              <span class="tab-toggle__switch">
                <%= check_box_tag "privacy_gaze[enabled]", "1", @user.privacy_gaze_enabled?, id: "privacy_gaze_enabled", class: "tab-toggle__input" %>
                <span class="tab-toggle__track" aria-hidden="true">
                  <span class="tab-toggle__thumb"></span>
                </span>
              </span>
            </label>
            <p class="privacy-hint privacy-hint--lock" data-privacy-haze-preview-target="lockHint" id="privacy_gaze_lock_hint" hidden>Turning this off needs the camera to see you looking at the screen with the haze clear. Face the camera, then try again. If the camera is missing or broken, this unlocks by itself.</p>

            <div class="privacy-group privacy-group--applies privacy-group--dim">
              <span class="privacy-label" id="privacy_sections_label">Applies to</span>
              <%= hidden_field_tag "privacy_gaze[sections][]", "", id: nil %>
              <div class="privacy-chips" role="group" aria-labelledby="privacy_sections_label">
                <% @privacy_sections.each do |key, label| %>
                  <label class="privacy-chip">
                    <%= check_box_tag "privacy_gaze[sections][]", key, gaze["sections"].include?(key), id: "privacy_section_#{key}" %>
                    <span><%= label %></span>
                  </label>
                <% end %>
              </div>
              <p class="privacy-hint">Page content only, never the navigation. The camera stays off in other sections.</p>
            </div>

            <div class="privacy-group privacy-group--dim">
              <div class="privacy-group__head">
                <div>
                  <h4 class="privacy-group__title">Tuning</h4>
                  <p class="privacy-group__sub">Saved as you move each slider.</p>
                </div>
              </div>
              <div class="privacy-tuning">
                <div class="privacy-range">
                  <label for="privacy_gaze_sensitivity">Sensitivity</label>
                  <output data-echo="privacy_gaze_sensitivity"><%= gaze["sensitivity"] %></output>
                  <%= range_field_tag "privacy_gaze[sensitivity]", gaze["sensitivity"], id: "privacy_gaze_sensitivity", min: 1, max: 10, step: 1 %>
                  <div class="privacy-range__ends"><span>Relaxed</span><span>Strict</span></div>
                  <p class="privacy-range__caption">How far you can turn your head before it counts as looking away.</p>
                </div>

                <div class="privacy-range">
                  <label for="privacy_gaze_haze_strength">Haze strength</label>
                  <output data-echo="privacy_gaze_haze_strength"><%= gaze["haze_strength"] %></output>
                  <%= range_field_tag "privacy_gaze[haze_strength]", gaze["haze_strength"], id: "privacy_gaze_haze_strength", min: 1, max: 10, step: 1, data: { privacy_haze_preview_target: "strength", action: "input->privacy-haze-preview#peek" } %>
                  <div class="privacy-range__ends"><span>Light</span><span>Opaque</span></div>
                  <p class="privacy-range__caption">Light keeps shapes visible; opaque hides everything.</p>
                </div>

                <div class="privacy-range">
                  <label for="privacy_gaze_away_ms">Haze after looking away</label>
                  <output data-echo="privacy_gaze_away_ms"><%= (gaze["away_ms"] / 1000.0).round(2) %>s</output>
                  <%= range_field_tag "privacy_gaze[away_ms]", gaze["away_ms"], id: "privacy_gaze_away_ms", min: 500, max: 15_000, step: 100, data: { echo_scale: 1000, echo_unit: "s" } %>
                  <div class="privacy-range__ends"><span>0.5s</span><span>15s</span></div>
                  <p class="privacy-range__caption">Short glances at a second screen stay clear.</p>
                </div>

                <div class="privacy-range">
                  <label for="privacy_gaze_clear_ms">Clear after looking back</label>
                  <output data-echo="privacy_gaze_clear_ms"><%= (gaze["clear_ms"] / 1000.0).round(2) %>s</output>
                  <%= range_field_tag "privacy_gaze[clear_ms]", gaze["clear_ms"], id: "privacy_gaze_clear_ms", min: 0, max: 2000, step: 50, data: { echo_scale: 1000, echo_unit: "s" } %>
                  <div class="privacy-range__ends"><span>Instant</span><span>2s</span></div>
                  <p class="privacy-range__caption">A short wait avoids flicker when you glance back.</p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="privacy-group privacy-group--dim">
            <div class="privacy-group__head">
              <div>
                <h4 class="privacy-group__title">Preview</h4>
                <p class="privacy-group__sub">What the haze does to a page at the current strength.</p>
              </div>
              <button type="button" class="btn btn-secondary btn-sm privacy-preview__hold"
                      data-action="pointerdown->privacy-haze-preview#hold pointerup->privacy-haze-preview#release pointerleave->privacy-haze-preview#release pointercancel->privacy-haze-preview#release keydown->privacy-haze-preview#hold keyup->privacy-haze-preview#release blur->privacy-haze-preview#release contextmenu->privacy-haze-preview#hold">Hold to preview haze</button>
            </div>
            <div class="privacy-preview__tile" data-privacy-haze-preview-target="tile" aria-hidden="true">
              <div class="privacy-preview__nav"><span class="privacy-preview__brand"></span><i></i><i></i><i></i>
              </div>
              <div class="privacy-preview__page" data-privacy-haze-preview-target="page">
                <h4>Launch notes</h4>
                <p>Pricing is settled for the first cohort. Next up: the onboarding email and a short demo for the two pilot teams.</p>
                <div class="privacy-preview__rows"><span>Draft the onboarding sequence</span><span>Book pilot demo calls</span></div>
              </div>
              <span class="privacy-preview__state" data-privacy-haze-preview-target="state" data-hazed="false">Clear</span>
            </div>
          </div>

        <div class="privacy-panels" data-controller="privacy-gaze-calibrate" data-privacy-gaze-calibrate-face-url-value="<%= settings_security_privacy_face_path %>">
          <div class="privacy-panel privacy-calibrate" id="privacy-calibration">
            <div class="privacy-calibrate__row">
              <div>
                <span class="privacy-calibrate__eyebrow">Calibration</span>
                <strong data-privacy-gaze-calibrate-target="status">Not calibrated</strong>
                <p data-privacy-gaze-calibrate-target="message" aria-live="polite">Follow a dot to the centre and the four corners of the screen so wide monitors and corners count as looking. Each screen (laptop, external monitor) keeps its own calibration; the matching one is used automatically. This device only.</p>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" data-privacy-gaze-calibrate-target="button" data-action="privacy-gaze-calibrate#toggle">Calibrate</button>
            </div>
            <div class="privacy-calibrate__stage" data-privacy-gaze-calibrate-target="stage" hidden>
              <video class="privacy-calibrate__preview" data-privacy-gaze-calibrate-target="preview" muted playsinline hidden></video>
              <div class="privacy-calibrate__side">
                <span class="privacy-calibrate__live" data-privacy-gaze-calibrate-target="live" aria-live="off"></span>
              </div>
            </div>
            <ul class="privacy-profiles" data-privacy-gaze-calibrate-target="profiles" aria-label="Calibrated screens" hidden></ul>
            <p class="privacy-status" data-privacy-gaze-calibrate-target="haze" aria-live="polite" hidden></p>
          </div>

          <div class="privacy-panel privacy-enroll">
            <div class="privacy-calibrate__row">
              <div>
                <span class="privacy-calibrate__eyebrow">Face ID</span>
                <strong data-privacy-gaze-calibrate-target="enrollStatus">Checking…</strong>
                <p data-privacy-gaze-calibrate-target="enrollMessage" aria-live="polite">Only you clear the haze. Anyone else looking at the screen hazes it, even with you there. Your face data never leaves your account.</p>
              </div>
              <div class="privacy-enroll__actions">
                <button type="button" class="btn btn-secondary btn-sm" data-privacy-gaze-calibrate-target="enrollButton" data-action="privacy-gaze-calibrate#enroll">Enroll face</button>
                <button type="button" class="btn btn-secondary btn-sm" data-privacy-gaze-calibrate-target="removeButton" data-action="privacy-gaze-calibrate#removeFace" hidden>Remove face ID</button>
              </div>
            </div>
            <div class="privacy-enroll__stage" data-privacy-gaze-calibrate-target="enrollStage" data-ready="false" hidden>
              <div class="privacy-enroll__frame">
                <video data-privacy-gaze-calibrate-target="enrollPreview" muted playsinline></video>
                <span class="privacy-enroll__oval" aria-hidden="true"></span>
              </div>
              <div class="privacy-enroll__side">
                <p class="privacy-enroll__guide">Look at the screen. Both ears visible. No mask, scarf or hand over your face.</p>
                <ul class="privacy-enroll__checks" aria-label="Enrollment checks">
                  <li data-privacy-gaze-calibrate-target="check" data-check="oneFace" data-ok="false">One face</li>
                  <li data-privacy-gaze-calibrate-target="check" data-check="ears" data-ok="false">Ears visible</li>
                  <li data-privacy-gaze-calibrate-target="check" data-check="real" data-ok="false">Real person</li>
                  <li data-privacy-gaze-calibrate-target="check" data-check="camera" data-ok="false">Camera ok</li>
                </ul>
                <div class="privacy-enroll__steps" data-privacy-gaze-calibrate-target="enrollSteps" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
            </div>
          </div>
        </div>

          <p class="privacy-footnote">
            <kbd data-shortcut-id="privacy_haze"><%= @user.shortcut_binding("privacy_haze") %></kbd> toggles the haze from any screen. Turning it off needs the camera to see you looking at the screen, with the haze clear.
          </p>
        </div>
      </section>

      <section class="tab-toggle-section security-database-encryption">
        <header class="tab-toggle-section__header">
          <h3>Database Encryption</h3>
          <p>Encrypt the SQLCipher-configured SQLite databases used by this workspace.</p>
        </header>

        <div class="security-database-encryption__body">
          <% if @database_encryption_requires_recovery_secret %>
            <div class="security-database-encryption__message security-database-encryption__message--recovery-secret">
              <strong>Recovery passphrase required</strong>
              <p>Enter the user-held recovery passphrase to inspect or encrypt the configured SQLite databases.</p>
              <%= link_to "Enter Recovery Passphrase",
                    recovery_secret_path(return_to: settings_security_path),
                    class: "btn btn-primary btn-sm" %>
            </div>
          <% elsif @database_encryption_error.present? %>
            <div class="security-database-encryption__message security-database-encryption__message--error">
              <strong>Encryption unavailable</strong>
              <p><%= @database_encryption_error %></p>
            </div>
          <% elsif @database_encryption_results.blank? %>
            <p class="security-database-encryption__empty">No SQLCipher-enabled SQLite databases are configured for this environment.</p>
          <% else %>
            <div class="security-database-encryption__list">
              <% @database_encryption_results.each do |result| %>
                <% status = result.status.to_sym %>
                <% status_label = { plaintext: "Needs encryption", encrypted: "Encrypted", missing: "Missing", unreadable: "Needs attention" }.fetch(status, status.to_s.humanize) %>
                <div class="security-database-encryption__row security-database-encryption__row--<%= status %>">
                  <div class="security-database-encryption__path">
                    <span><%= File.basename(result.path.to_s) %></span>
                    <code><%= result.path %></code>
                    <% if result.error.present? %>
                      <small><%= result.error %></small>
                    <% end %>
                  </div>
                  <strong><%= status_label %></strong>
                </div>
              <% end %>
            </div>

            <% if @database_encryption_results.any? { |result| result.status == :plaintext } %>
              <div class="security-database-encryption__actions">
                <%= form_with url: settings_security_encrypt_database_path, method: :post, local: true, class: "security-database-encryption__form", data: { controller: "passphrase-download" } do %>
                  <div class="security-database-encryption__warning">
                    <strong>This passphrase becomes the database recovery key.</strong>
                    <p>Idea Foundry cannot recover it for you. Save it in at least two independent places before encrypting. The app will store a local copy for launchd/systemd at <code><%= @database_recovery_passphrase_file_path %></code>.</p>
                  </div>

                  <div class="typing-settings-field">
                    <label for="database_encryption_passphrase">Database recovery passphrase</label>
                    <%= password_field_tag "database_encryption[passphrase]", nil,
                          id: "database_encryption_passphrase",
                          class: "form-control",
                          autocomplete: "new-password",
                          minlength: 16,
                          required: true,
                          data: { passphrase_download_target: "passphrase" } %>
                  </div>

                  <div class="typing-settings-field">
                    <label for="database_encryption_passphrase_confirmation">Confirm recovery passphrase</label>
                    <%= password_field_tag "database_encryption[passphrase_confirmation]", nil,
                          id: "database_encryption_passphrase_confirmation",
                          class: "form-control",
                          autocomplete: "new-password",
                          minlength: 16,
                          required: true %>
                  </div>

                  <label class="security-database-encryption__ack" for="database_encryption_saved_primary">
                    <%= check_box_tag "database_encryption[saved_primary]", "1", false, id: "database_encryption_saved_primary", required: true %>
                    <span>I saved this passphrase in my primary password manager or recovery vault.</span>
                  </label>

                  <label class="security-database-encryption__ack" for="database_encryption_saved_secondary">
                    <%= check_box_tag "database_encryption[saved_secondary]", "1", false, id: "database_encryption_saved_secondary", required: true, data: { action: "change->passphrase-download#download" } %>
                    <span>I saved this passphrase in a second separate place — <strong>download a copy</strong> to confirm.</span>
                  </label>

                  <%= submit_tag "Encrypt SQLite Databases",
                        class: "btn btn-primary",
                        data: { turbo_confirm: "Encrypt the configured SQLite databases now? Continue only if the passphrase is saved in more than one place." } %>
                <% end %>
              </div>
            <% else %>
              <p class="security-database-encryption__empty">No plaintext configured databases need encryption.</p>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>

    <aside class="typing-settings-status">
      <section class="security-fingerprint-row security-fingerprint-row--typing">
        <div class="security-fingerprint-row__content">
          <span class="typing-settings-status__label">Typing Fingerprint</span>
          <% if @user.typing_fingerprint_configured? %>
            <strong>Stored</strong>
            <p><%= @user.typing_fingerprint["sample_count"] %> timing samples are saved in the database.</p>
          <% else %>
            <strong>Not trained</strong>
            <p>The next protected visit will ask for a longer setup passage.</p>
          <% end %>
        </div>
        <div class="security-fingerprint-row__action">
          <%= link_to (@user.typing_fingerprint_configured? ? "Redo Typing Fingerprint" : "Set Up Typing Fingerprint"),
                enroll_typing_lock_path(return_to: settings_security_path),
                class: "btn btn-secondary btn-sm" %>
        </div>
      </section>

      <section class="security-fingerprint-row security-fingerprint-row--authenticator">
        <div class="security-fingerprint-row__content">
          <span class="typing-settings-status__label">Authenticator App</span>
          <% if @user.authenticator_app_configured? %>
            <strong><%= @user.authenticator_app_enabled? ? "Enabled" : "Prepared" %></strong>
            <p>Scan this QR code with an authenticator app, or enter the setup key manually.</p>
            <div class="authenticator-setup-qr" aria-label="Authenticator app QR code">
              <%= raw @authenticator_app_qr_svg %>
            </div>
            <code class="authenticator-setup-secret"><%= @user.authenticator_app_secret %></code>
          <% else %>
            <strong>Off</strong>
            <p>Enable the authenticator app option and save to generate a QR code.</p>
          <% end %>
        </div>
      </section>

      <section class="security-fingerprint-row security-fingerprint-row--voice">
        <div class="security-fingerprint-row__content">
          <span class="typing-settings-status__label">Voice ID</span>
          <% if @user.voice_id_configured? %>
            <strong><%= @user.voice_id_enabled? ? "Enabled" : "Stored" %></strong>
            <p><%= @user.voice_id_fingerprint["sample_count"] %> voice recordings stored. Raw audio is never saved.</p>
          <% elsif @user.voice_id_requested? %>
            <strong>Setup required</strong>
            <p>Record yourself saying the passphrase 3 times to complete setup.</p>
          <% else %>
            <strong>Off</strong>
            <p>Enable the toggle above and save to start voice setup.</p>
          <% end %>
        </div>
        <div class="security-fingerprint-row__action">
          <% if @user.voice_id_configured? %>
            <%= link_to "Redo Voice ID", enroll_voice_id_path(return_to: settings_security_path), class: "btn btn-secondary btn-sm" %>
          <% elsif @user.voice_id_requested? %>
            <%= link_to "Set Up Voice ID", enroll_voice_id_path(return_to: settings_security_path), class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </section>

      <section class="security-fingerprint-row security-fingerprint-row--mobile-uplink">
        <div class="security-fingerprint-row__content">
          <span class="typing-settings-status__label">Mobile Uplink</span>
          <% if @user.mobile_uplink_enabled? %>
            <strong>Ready</strong>
            <p>Install the mobile uplink app, then scan the pairing QR to share this workspace id.</p>

            <div class="mobile-uplink-setup">
              <div class="mobile-uplink-setup__step">
                <span class="mobile-uplink-setup__label">1. Install app</span>
                <div class="mobile-uplink-setup__qr mobile-uplink-install-qr" aria-label="Mobile uplink install QR code">
                  <%= raw @mobile_uplink_install_qr_svg %>
                </div>
                <code class="mobile-uplink-setup__code"><%= @mobile_uplink_install_url %></code>
              </div>

              <div class="mobile-uplink-setup__step">
                <span class="mobile-uplink-setup__label">2. Connect to this app</span>
                <div class="mobile-uplink-setup__qr mobile-uplink-pairing-qr" aria-label="Mobile uplink pairing QR code">
                  <%= raw @mobile_uplink_pairing_qr_svg %>
                </div>
                <code class="mobile-uplink-setup__code mobile-uplink-id"><%= @user.mobile_uplink_id %></code>
              </div>
            </div>

            <p class="mobile-uplink-secure-copy">Super secure mode encrypts data multiple times before it leaves the phone or other device, and only this user's Idea Foundry app decodes it.</p>
          <% else %>
            <strong>Off</strong>
            <p>Enable Mobile Uplink and save to generate install and pairing QR codes.</p>
          <% end %>
        </div>
      </section>
    </aside>
  </div>
</div>
