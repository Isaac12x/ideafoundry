<%= render 'settings/upgrade_bar' %>
<div class="settings-container">
  <div class="page-header">
    <h2>Areas</h2>
    <div class="header-actions">
      <%= link_to settings_path, class: "btn btn-sm" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Settings
      <% end %>
    </div>
  </div>

  <%= form_with url: settings_features_path, method: :patch, local: true,
        class: "settings-features-form", data: { controller: "settings-autosave" } do |form| %>
    <div class="tab-toggle-list">
      <% User::FEATURE_KEYS.each do |key| %>
        <label class="tab-toggle" for="feature_<%= key %>">
          <div class="tab-toggle__text">
            <span class="tab-toggle__name"><%= User::FEATURE_LABELS[key] %></span>
            <span class="tab-toggle__description"><%= User::FEATURE_DESCRIPTIONS[key] %></span>
          </div>
          <span class="tab-toggle__switch">
            <%= hidden_field_tag "features[#{key}]", "0", id: nil %>
            <%= check_box_tag "features[#{key}]", "1", @user.feature_enabled?(key),
                  id: "feature_#{key}", class: "tab-toggle__input",
                  data: { action: "change->settings-autosave#toggleChanged" } %>
            <span class="tab-toggle__track" aria-hidden="true">
              <span class="tab-toggle__thumb"></span>
            </span>
          </span>
        </label>
      <% end %>
    </div>
  <% end %>
</div>
