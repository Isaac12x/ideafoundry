<%= render 'settings/upgrade_bar' %>
<div class="settings-container">
  <div class="page-header">
    <h2>Settings</h2>
    <div style="display:flex;gap:0.5rem;align-items:center;">
      <button class="btn btn-sm" title="Activity log" data-action="click->activity-panel#open">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Activity
      </button>
    </div>
  </div>

  <div class="settings-list">
    <div class="settings-group-label">Features</div>

    <%= form_with url: settings_features_path, method: :patch, local: true,
          class: "settings-features-form", data: { controller: "settings-autosave" } do |form| %>
      <div class="tab-toggle-list">
        <% User::FEATURE_KEYS.each do |key| %>
          <label class="tab-toggle" for="feature_<%= key %>">
            <div class="tab-toggle__text">
              <span class="tab-toggle__name"><%= User::FEATURE_LABELS[key] %></span>
              <span class="tab-toggle__description"><%= User::FEATURE_DESCRIPTIONS[key] %></span>
            </div>
            <span class="tab-toggle__switch">
              <%= hidden_field_tag "features[#{key}]", "0", id: nil %>
              <%= check_box_tag "features[#{key}]", "1", @user.feature_enabled?(key),
                    id: "feature_#{key}", class: "tab-toggle__input",
                    data: { action: "change->settings-autosave#toggleChanged" } %>
              <span class="tab-toggle__track" aria-hidden="true">
                <span class="tab-toggle__thumb"></span>
              </span>
            </span>
          </label>
        <% end %>
      </div>
    <% end %>

    <div class="settings-group-label">Appearance</div>

    <%= link_to settings_display_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Display</h3>
        <p>Quote, contrast, and idea tab visibility</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <%= link_to settings_topologies_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Topologies & Graph</h3>
        <p>Configure graph visuals, behavior, and topology defaults</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <%= link_to settings_lists_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Lists</h3>
        <p>Choose the default Lists view and manage list behavior</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <div class="settings-group-label">Ideas</div>

    <%= link_to settings_scoring_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Scoring System</h3>
        <p>Configure how ideas are scored and weighted</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <%= link_to settings_templates_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Templates</h3>
        <p>Manage idea templates and custom fields</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <div class="settings-group-label">AI</div>

    <%= link_to settings_local_agent_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>AI Agents</h3>
        <p>Run the continuous app-owned agent and review its recommendations</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <%= link_to settings_idea_work_tokens_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Idea Work Tokens</h3>
        <p>Enable scoped agent access for individual idea documents</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <div class="settings-group-label">Integrations</div>

    <%= link_to settings_email_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Email</h3>
        <p>Configure recipients and sender settings for sharing ideas via email</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <% if feature_enabled?(:kb) %>
      <%= link_to settings_kb_path, class: "settings-row" do %>
        <div class="settings-row-info">
          <h3>KB Folders</h3>
          <p>Configure folders of markdown documents for the Knowledge Base</p>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      <% end %>
    <% end %>

    <%= link_to settings_api_keys_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>API Keys</h3>
        <p>Manage keys for programmatic idea submission</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <div class="settings-group-label">Data</div>

    <%= link_to settings_exports_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Export & Backup</h3>
        <p>Export your workspace and manage backups</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <%= link_to settings_activity_path, class: "settings-row" do %>
      <div class="settings-row-info">
        <h3>Activity</h3>
        <p>Audit log of changes to ideas, lists, boards, topologies, and settings</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>

    <div class="settings-group-label">Security</div>

    <%= link_to settings_security_path, class: "settings-row settings-row--last" do %>
      <div class="settings-row-info">
        <h3>Security</h3>
        <p>Manage fingerprint training, unlock timing, and app protection</p>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    <% end %>
  </div>
</div>
