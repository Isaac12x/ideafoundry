<%= render 'settings/upgrade_bar' %>
<div class="settings-container">
  <div class="page-header">
    <h2>Idea Work Tokens</h2>
    <%= link_to settings_path, class: "btn btn-sm" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Settings
    <% end %>
  </div>

  <%= form_with url: settings_idea_work_tokens_path, method: :patch, local: true, class: "idea-tabs-form" do %>
    <section class="tab-toggle-section">
      <header class="tab-toggle-section__header">
        <h3>Access</h3>
        <p>Allow per-idea tokens for scoped agent document access.</p>
      </header>

      <%= hidden_field_tag "idea_work_tokens[enabled]", "0" %>
      <label class="tab-toggle" for="idea_work_tokens_enabled">
        <div class="tab-toggle__text">
          <span class="tab-toggle__name">Enable idea work tokens</span>
          <span class="tab-toggle__description">When off, existing idea work tokens cannot read or update idea documents.</span>
        </div>
        <span class="tab-toggle__switch">
          <%= check_box_tag "idea_work_tokens[enabled]", "1", @user.idea_work_tokens_enabled?, id: "idea_work_tokens_enabled", class: "tab-toggle__input" %>
          <span class="tab-toggle__track" aria-hidden="true">
            <span class="tab-toggle__thumb"></span>
          </span>
        </span>
      </label>
    </section>

    <div class="tab-toggle-actions">
      <%= submit_tag "Save Settings", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
