<div class="ideas-index-container">
  <div class="ideas-header">
    <div>
      <h1>Archived Ideas</h1>
      <p class="text-muted">Ideas you've archived. Restore them anytime.</p>
    </div>
    <div class="header-actions">
      <%= link_to ideas_path, class: "btn btn-sm" do %>
        &larr; Back to Ideas
      <% end %>
    </div>
  </div>

  <% if @ideas.any? %>
    <div class="ideas-grid">
      <% @ideas.each do |idea| %>
        <div class="idea-card archived">
          <div class="idea-card-header">
            <h3><%= link_to idea.title, idea_path(idea) %></h3>
            <span class="idea-state <%= idea.state %>"><%= idea.state.humanize %></span>
          </div>
          <div class="idea-card-meta">
            <span class="text-muted">Archived <%= time_ago_in_words(idea.discarded_at) %> ago</span>
            <span class="idea-score <%= (idea.computed_score || 0) >= 0 ? 'positive' : 'negative' %>">
              Score: <%= number_with_precision(idea.computed_score || 0, precision: 1) %>
            </span>
          </div>
          <div class="idea-card-actions">
            <%= button_to "Restore", restore_idea_path(idea), method: :post, class: "btn btn-sm btn-primary" %>
            <%= link_to "View", idea_path(idea), class: "btn btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <%= paginate @ideas %>
  <% else %>
    <div class="empty-state">
      <p>No archived ideas.</p>
      <%= link_to "View all ideas", ideas_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
