<div class="idea-draft-resume idea-draft-resume--toast" data-idea-draft-persist-target="prompt" role="status" hidden>
  <div>
    <strong>Finish your unsaved idea?</strong>
    <p data-idea-draft-persist-target="idleMessage">No rush — when you are ready to come back, your unfinished ideas are in one place.</p>
    <p data-idea-draft-persist-target="storedMessage" hidden>A protected draft was saved on this device <span data-idea-draft-persist-target="savedAt">recently</span>. Restore it so the idea is not lost, or discard it.</p>
    <p class="idea-draft-resume__error" data-idea-draft-persist-target="error"></p>
  </div>
  <div class="idea-draft-resume__actions">
    <%= link_to "View Uncompleted", uncompleted_ideas_path, class: "btn btn-primary btn-sm", data: { turbo_frame: "_top" } %>
    <span data-idea-draft-persist-target="storedActions" hidden>
      <button type="button" class="btn btn-sm" data-action="idea-draft-persist#restore">Restore Draft</button>
      <button type="button" class="btn btn-sm" data-action="idea-draft-persist#discard">Discard</button>
    </span>
    <button type="button" class="btn btn-sm" data-action="idea-draft-persist#dismiss">Keep Writing</button>
  </div>
</div>

<% if idea.errors.any? %>
  <div class="alert alert-error">
    <h4><%= pluralize(idea.errors.count, "error") %> prohibited this idea from being saved:</h4>
    <ul>
      <% idea.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% templates = @templates || [] %>
<% show_template_step = idea.new_record? && templates.any? %>

<div data-controller="template-step attachment-viewer" data-template-step-selected-value="<%= idea.persisted? || idea.template_id.present? || idea.errors.any? %>">

  <% if show_template_step %>
    <!-- ===== STEP 1: Template Selection ===== -->
    <div class="template-step" data-template-step-target="step">
      <h3>Choose a Template</h3>
      <p>Pick a template to structure your idea, or start with a blank form.</p>
      <div class="template-cards">
        <% templates.each do |tmpl| %>
          <div class="template-card"
               data-action="click->template-step#select"
               data-template-id="<%= tmpl.id %>">
            <span class="template-card-name"><%= tmpl.name %></span>
            <% if tmpl.is_default? %>
              <span class="template-card-badge">Default</span>
            <% end %>
            <span class="template-card-meta">
              <%= pluralize(tmpl.field_definitions&.size || 0, 'field') %>
            </span>
          </div>
        <% end %>
      </div>
      <button type="button" class="template-step-skip" data-action="click->template-step#skip">
        Skip &mdash; blank form
      </button>
    </div>
  <% end %>

  <!-- ===== STEP 2: Full Form ===== -->
  <div class="form-layout" data-controller="template-switch" data-template-step-target="form" <% if show_template_step %>style="display:none"<% end %>>

    <% if templates.any? %>
      <!-- Template Selector (hidden during step 1, visible as dropdown in form) -->
      <div class="form-template-selector">
        <label class="form-template-label">Template</label>
        <select class="form-control template-select"
                name="idea[template_id]"
                data-template-switch-target="selector"
                data-action="change->template-switch#change">
          <option value="">No template</option>
          <% templates.each do |tmpl| %>
            <option value="<%= tmpl.id %>"
                    <%= 'selected' if idea.template_id == tmpl.id %>
                    data-default="<%= tmpl.is_default? %>"
                    data-scoring-system-ids="<%= tmpl.enabled_scoring_system_ids.join(',') %>">
              <%= tmpl.name %><%= ' (default)' if tmpl.is_default? %>
            </option>
          <% end %>
        </select>
      </div>
    <% end %>

    <!-- ===== MAIN COLUMN ===== -->
    <div class="form-main">

      <!-- Title -->
      <div class="form-panel">
        <h3 class="form-panel-title">Basics</h3>
        <div class="form-group">
          <%= form.label :title %>
          <%= form.text_field :title, class: "form-control", required: true, placeholder: "What's the idea?" %>
        </div>
        <div class="form-group">
          <%= form.label :tldr, "TL;DR" %>
          <%= form.text_field :tldr, class: "form-control", placeholder: "One sentence: what is this idea and why it matters?" %>
        </div>
        <div class="form-group">
          <%= form.label :state %>
          <%= form.select :state,
              Idea.states.keys.map { |k| [k.humanize, k] },
              {},
              class: "form-control" %>
        </div>
        <div class="form-group form-check">
          <%= form.check_box :for_licensing, class: "form-check__input", id: "idea_for_licensing" %>
          <label class="form-check__label" for="idea_for_licensing">
            Track this idea for licensing
            <span class="form-check__hint">Swaps Tools &amp; Notes for a Potential Licensors pipeline and adds it to the Licensing CRM.</span>
          </label>
        </div>
      </div>

      <!-- Hero Image -->
      <% hero_drawing = idea.persisted? ? idea.hero_drawing : nil %>
      <% hero_default_mode = hero_drawing ? "draw" : "file" %>
      <div class="form-panel">
        <h3 class="form-panel-title">Hero Image</h3>
        <div class="hero-mode-toggle"
             data-controller="idea-drawings"
             data-idea-drawings-role-value="hero"
             data-idea-drawings-create-url-value="<%= idea.persisted? ? idea_drawings_path(idea) : '#' %>"
             data-idea-drawings-show-url-pattern-value="/ideas/<%= idea.id %>/drawings/__ID__"
             data-idea-drawings-thumbnail-mode-value="single"
             data-action="keydown@window->idea-drawings#closeOnEsc">
          <div class="hero-mode-tabs">
            <button type="button"
                    class="hero-mode-tab <%= 'active' if hero_default_mode == 'file' %>"
                    data-idea-drawings-target="fileToggle"
                    data-action="click->idea-drawings#selectFile">Upload File</button>
            <button type="button"
                    class="hero-mode-tab <%= 'active' if hero_default_mode == 'draw' %>"
                    data-idea-drawings-target="drawToggle"
                    data-action="click->idea-drawings#selectDraw">Draw</button>
          </div>

          <div class="hero-mode-panel <%= 'hidden' if hero_default_mode == 'draw' %>"
               data-idea-drawings-target="filePanel">
            <div data-controller="dropzone" data-dropzone-multiple-value="false" data-dropzone-accept-value="image/*" data-dropzone-image-editor-outlet=".image-editor">
              <div class="dropzone" data-dropzone-target="zone" data-action="click->dropzone#click dragover->dropzone#dragover dragenter->dropzone#dragenter dragleave->dropzone#dragleave drop->dropzone#drop">
                <div class="dropzone__label" data-dropzone-target="placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  <span>Drag & drop an image or <strong>browse</strong></span>
                  <small>Recommended: at least 800×600px</small>
                </div>
                <div class="dropzone__preview-hero" data-dropzone-target="preview">
                  <% if idea.hero_image.attached? %>
                    <%= image_tag idea.hero_image, style: "max-width:100%;max-height:200px;border-radius:6px;border:1px solid var(--border-default);" %>
                  <% end %>
                </div>
              </div>
              <%= form.file_field :hero_image, accept: "image/*", class: "form-control", style: "display:none", data: { dropzone_target: "input" } %>
            </div>
          </div>

          <div class="hero-mode-panel <%= 'hidden' if hero_default_mode == 'file' %>"
               data-idea-drawings-target="drawPanel">
            <div class="idea-drawings__header">
              <button type="button" class="btn btn-sm btn-primary"
                      data-action="click->idea-drawings#open">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                <%= hero_drawing ? "Edit Hero Drawing" : "Create Hero Drawing" %>
              </button>
            </div>
            <div class="idea-drawings__list" data-idea-drawings-target="list">
              <% if hero_drawing %>
                <%= render "drawings/thumbnail", drawing: hero_drawing %>
              <% end %>
            </div>
            <div class="idea-drawings__empty <%= 'hidden' if hero_drawing %>"
                 data-idea-drawings-target="empty">
              <p>No hero drawing yet.</p>
            </div>
            <div class="idea-drawings__modal hidden"
                 data-idea-drawings-target="modal"
                 data-action="click->idea-drawings#closeOnBackdrop">
              <div class="idea-drawings__modal-dialog">
                <div class="idea-drawings__modal-header">
                  <span class="idea-drawings__modal-title">Hero Drawing</span>
                  <button type="button" class="btn btn-sm" data-action="click->idea-drawings#close">Close</button>
                </div>
                <div class="idea-drawings__modal-body">
                  <div class="excalidraw-mount" data-idea-drawings-target="mount" data-standalone="false"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Description (TipTap) -->
      <div class="form-panel">
        <h3 class="form-panel-title">Description</h3>
        <div class="form-group" data-controller="editor"
             data-editor-content-value="<%= idea.description&.body&.to_html&.gsub('"', '&quot;') || '' %>"
             data-editor-upload-url-value="<%= uploads_path %>">
          <%= form.hidden_field :description, data: { editor_target: "input", action: "idea-draft:restore-description->editor#restoreFromIdeaDraft" } %>
          <div class="tiptap-toolbar" data-editor-target="toolbar">
            <div class="tiptap-toolbar__group">
              <button type="button" data-cmd="bold" title="Bold"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z"/><path d="M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"/></svg></button>
              <button type="button" data-cmd="italic" title="Italic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg></button>
              <button type="button" data-cmd="underline" title="Underline"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3v7a6 6 0 006 6 6 6 0 006-6V3"/><line x1="4" y1="21" x2="20" y2="21"/></svg></button>
              <button type="button" data-cmd="strike" title="Strikethrough"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.3 4.9c-1.1-.7-2.6-1.2-4.3-1.2-3.2 0-5 1.6-5 3.8 0 1 .3 1.8 1 2.5"/><line x1="4" y1="12" x2="20" y2="12"/><path d="M17 14c.2.5.3 1.1.3 1.7 0 2.4-2 4.3-5.3 4.3-1.8 0-3.5-.6-4.7-1.5"/></svg></button>
            </div>
            <div class="tiptap-toolbar__group">
              <button type="button" data-cmd="heading" data-level="1" title="Heading 1">H1</button>
              <button type="button" data-cmd="heading" data-level="2" title="Heading 2">H2</button>
              <button type="button" data-cmd="heading" data-level="3" title="Heading 3">H3</button>
            </div>
            <div class="tiptap-toolbar__group">
              <button type="button" data-cmd="bulletList" title="Bullet List"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg></button>
              <button type="button" data-cmd="orderedList" title="Numbered List"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><text x="3" y="7" font-size="7" fill="currentColor" stroke="none">1</text><text x="3" y="13" font-size="7" fill="currentColor" stroke="none">2</text><text x="3" y="19" font-size="7" fill="currentColor" stroke="none">3</text></svg></button>
              <button type="button" data-cmd="blockquote" title="Blockquote"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg></button>
            </div>
            <div class="tiptap-toolbar__group">
              <button type="button" data-cmd="code" title="Inline Code"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
              <button type="button" data-cmd="codeBlock" title="Code Block"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="12" y1="2" x2="12" y2="22" stroke-dasharray="2 2"/></svg></button>
              <button type="button" data-cmd="horizontalRule" title="Horizontal Rule">&mdash;</button>
            </div>
            <div class="tiptap-toolbar__group">
              <button type="button" data-cmd="link" title="Link"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg></button>
              <button type="button" data-cmd="image" title="Insert Image"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></button>
            </div>
            <div class="tiptap-toolbar__group tiptap-toolbar__group--end">
              <button type="button" data-cmd="undo" title="Undo"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></button>
              <button type="button" data-cmd="redo" title="Redo"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg></button>
            </div>
          </div>
          <div class="tiptap-editor" data-editor-target="editor"></div>
        </div>
      </div>

      <!-- Attachments -->
      <% attachment_drawings = idea.persisted? ? idea.attachment_drawings.to_a : [] %>
      <% image_attachments = idea.image_attachments %>
      <% document_attachments = idea.document_attachments %>
      <div class="form-panel">
        <h3 class="form-panel-title">Attachments</h3>

        <div class="current-attachments"
             data-controller="attachment-reorder"
             data-attachment-reorder-url-value="<%= reorder_idea_attachments_path(idea) if idea.persisted? %>"
             data-action="dropzone:uploaded->attachment-reorder#appendItems attachment:removed->attachment-reorder#sync attachment:updated->attachment-reorder#sync">

          <% if idea.attachments.attached? %>
            <p class="form-hint">Drag attachments or use the arrow buttons to rearrange them. OCR runs locally through the bundled compose service.</p>
          <% end %>

          <div class="current-attachments__section current-attachments__section--images">
            <div class="current-attachments__section-header">
              <h4>Images</h4>
              <span><%= image_attachments.size %></span>
            </div>
            <ul class="current-attachments__list"
                data-attachment-reorder-target="list"
                data-attachment-list="image">
              <% image_attachments.each do |attachment| %>
                <%= render "idea_attachments/item", attachment: attachment, idea: idea %>
              <% end %>
            </ul>
            <p class="current-attachments__empty" data-attachment-empty="image" <%= "hidden" if image_attachments.any? %>>No images attached.</p>
          </div>

          <div class="current-attachments__section current-attachments__section--documents">
            <div class="current-attachments__section-header">
              <h4>Documents</h4>
              <span><%= document_attachments.size %></span>
            </div>
            <ul class="current-attachments__list"
                data-attachment-reorder-target="list"
                data-attachment-list="document">
              <% document_attachments.each do |attachment| %>
                <%= render "idea_attachments/item", attachment: attachment, idea: idea %>
              <% end %>
            </ul>
            <p class="current-attachments__empty" data-attachment-empty="document" <%= "hidden" if document_attachments.any? %>>No documents attached.</p>
          </div>

          <p class="form-hint" data-attachment-reorder-target="status" aria-live="polite"></p>

          <div data-controller="dropzone"
               data-dropzone-multiple-value="true"
               data-dropzone-accept-value="*/*"
               data-dropzone-upload-url-value="<%= idea.persisted? ? idea_attachments_path(idea) : '' %>"
               data-dropzone-image-editor-outlet=".image-editor">
            <div class="dropzone" data-dropzone-target="zone" data-action="click->dropzone#click dragover->dropzone#dragover dragenter->dropzone#dragenter dragleave->dropzone#dragleave drop->dropzone#drop">
              <div class="dropzone__label" data-dropzone-target="placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                <span>Drag images or documents here, or <strong>browse</strong></span>
                <small>Images, PDFs, emails, and notes</small>
              </div>
              <div class="dropzone__preview-grid" data-dropzone-target="preview"></div>
            </div>
            <input type="file" multiple style="display:none" data-dropzone-target="input">
          </div>
        </div>

        <% if idea.persisted? %>
          <div class="form-subsection">
            <h4 class="form-subsection-title">Drawn Attachments</h4>
            <%= render "drawings/form_section",
                  idea: idea, role: "attachment", title: "Drawn Attachments",
                  mode: "list", drawings: attachment_drawings,
                  add_label: "Add Drawing as Attachment" %>
          </div>
        <% end %>
      </div>

      <!-- Drawings -->
      <% if idea.persisted? %>
        <% general_drawings = idea.general_drawings.to_a %>
        <div class="form-panel">
          <h3 class="form-panel-title">Drawings</h3>
          <%= render "drawings/form_section",
                idea: idea, role: "general", title: "Drawings",
                mode: "list", drawings: general_drawings,
                add_label: "Add Drawing" %>
        </div>
      <% end %>

      <!-- Topologies & Lists -->
      <div class="form-panel">
        <h3 class="form-panel-title">Organization</h3>

        <div class="form-group">
          <label>Topologies</label>
          <% if topologies.any? %>
            <% children_by_parent = topologies.group_by(&:parent_id) %>
            <div class="topology-picker" data-controller="topology-picker">
              <div class="topology-picker__search-wrap">
                <svg class="topology-picker__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" class="topology-picker__search"
                       placeholder="Search topologies…" aria-label="Search topologies"
                       data-topology-picker-target="search"
                       data-action="input->topology-picker#filter">
              </div>
              <div class="topology-tree" role="tree" data-topology-picker-target="tree">
                <%= render partial: "ideas/topology_node",
                      collection: (children_by_parent[nil] || []), as: :topology,
                      locals: { idea: idea, children_by_parent: children_by_parent } %>
              </div>
              <p class="topology-picker__empty" data-topology-picker-target="empty" hidden>No topologies match.</p>
            </div>
          <% else %>
            <p class="text-muted" style="font-size: 0.85rem;">No topologies yet. <%= link_to "Create one", new_topology_path %>.</p>
          <% end %>
        </div>

        <% unless idea.new_record? || idea.draft? %>
          <% kanban_boards ||= [] %>
          <% named_lists ||= [] %>

          <div class="form-group">
            <label>Kanban Boards</label>
            <% if kanban_boards.any? %>
              <div class="kanban-board-pickers">
                <% kanban_boards.each do |board| %>
                  <% board_lists = board.lists.to_a %>
                  <% current_board_list = idea.idea_lists.joins(:list).find_by(lists: { kind: "kanban", kanban_board_id: board.id })&.list %>
                  <div class="kanban-board-picker">
                    <h4><%= board.name %></h4>
                    <div class="checkbox-group">
                      <div class="checkbox-item">
                        <%= radio_button_tag "kanban_list_ids[#{board.id}]", "", current_board_list.nil?, id: "kanban_board_#{board.id}_none" %>
                        <%= label_tag "kanban_board_#{board.id}_none", "None" %>
                      </div>
                      <% board_lists.each do |list| %>
                        <div class="checkbox-item">
                          <%= radio_button_tag "kanban_list_ids[#{board.id}]", list.id, current_board_list == list, id: "kanban_board_#{board.id}_list_#{list.id}" %>
                          <%= label_tag "kanban_board_#{board.id}_list_#{list.id}", list.name %>
                        </div>
                      <% end %>
                      <% if board_lists.empty? %>
                        <p class="text-muted" style="font-size: 0.85rem;">No columns on this board yet. Create one from the Lists page.</p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted" style="font-size: 0.85rem;">No kanban boards yet. Create one from the Lists page.</p>
            <% end %>
          </div>

          <div class="form-group">
            <label>Named Lists</label>
            <div class="checkbox-group">
              <%= hidden_field_tag "named_list_ids[]", "" %>
              <% named_lists.each do |list| %>
                <div class="checkbox-item">
                  <%= check_box_tag "named_list_ids[]", list.id, idea.lists.include?(list), id: "named_list_#{list.id}" %>
                  <%= label_tag "named_list_#{list.id}", list.name %>
                </div>
              <% end %>
              <% if named_lists.empty? %>
                <p class="text-muted" style="font-size: 0.85rem;">No named lists yet. Create one from the Lists page.</p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Custom Fields from Template (flat, sorted by position) -->
      <% effective_fields = idea.effective_field_definitions %>
      <% if effective_fields.present? %>
        <div class="form-panel" data-template-switch-target="customFieldsPanel">
          <h3 class="form-panel-title">Custom Fields</h3>
          <div class="weight-grid">
            <% effective_fields.sort_by { |f| f['position'].to_i }.each do |field| %>
              <% meta_key = field['instance_id'] || field['name'] %>
              <% field_value = idea.metadata&.dig(meta_key) || field['default_value'] || '' %>
              <div class="weight-item" data-custom-field="<%= meta_key %>" data-field-instance-id="<%= field['instance_id'] %>">
                <label class="weight-label">
                  <%= field['label'] || field['name'].humanize %>
                  <% if field['required'] %><span style="color:var(--danger)">*</span><% end %>
                </label>
                <div class="weight-input-group">
                  <% case field['type'] %>
                  <% when 'textarea' %>
                    <textarea name="idea[metadata][<%= meta_key %>]"
                              class="weight-input" style="text-align:left;min-height:80px;"
                              placeholder="<%= field['placeholder'] %>"
                              <%= 'required' if field['required'] %>><%= field_value %></textarea>
                  <% when 'select' %>
                    <select name="idea[metadata][<%= meta_key %>]" class="weight-input"
                            <%= 'required' if field['required'] %>>
                      <option value="">Select...</option>
                      <% (field['options'] || []).each do |opt| %>
                        <option value="<%= opt %>" <%= 'selected' if opt == field_value %>><%= opt %></option>
                      <% end %>
                    </select>
                  <% when 'number' %>
                    <input type="number" name="idea[metadata][<%= meta_key %>]"
                           value="<%= field_value %>" class="weight-input"
                           <%= 'required' if field['required'] %>>
                  <% when 'boolean' %>
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                      <input type="checkbox" name="idea[metadata][<%= meta_key %>]"
                             value="true" <%= 'checked' if field_value.to_s == 'true' %>>
                      <%= field['label'] || field['name'].humanize %>
                    </label>
                  <% when 'date' %>
                    <input type="date" name="idea[metadata][<%= meta_key %>]"
                           value="<%= field_value %>" class="weight-input"
                           <%= 'required' if field['required'] %>>
                  <% when 'url' %>
                    <input type="url" name="idea[metadata][<%= meta_key %>]"
                           value="<%= field_value %>" class="weight-input" style="text-align:left;"
                           placeholder="<%= field['placeholder'] %>"
                           <%= 'required' if field['required'] %>>
                  <% else %>
                    <input type="text" name="idea[metadata][<%= meta_key %>]"
                           value="<%= field_value %>" class="weight-input" style="text-align:left;"
                           placeholder="<%= field['placeholder'] %>"
                           <%= 'required' if field['required'] %>>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Back-of-the-napkin Calculations -->
      <%= render "napkin", idea: idea, form: form %>

      <!-- Hidden container for dynamic tab panels rendered by template-switch JS -->
      <div data-template-switch-target="tabPanelsContainer"></div>

    </div>

    <!-- ===== SIDEBAR ===== -->
    <div class="form-sidebar">

      <!-- Orphaned Content (from template switch) -->
      <div class="form-panel orphaned-panel" data-template-switch-target="orphanedPanel" style="display:none;">
        <h3 class="form-panel-title">Orphaned Content</h3>
        <p class="orphaned-hint">These values don't match the new template. Drag them into a field above, or they'll be discarded.</p>
        <div class="orphaned-list" data-template-switch-target="orphanedList"></div>
      </div>

      <!-- Scoring -->
      <% scoring_user = idea.user || @user %>
      <% active_scoring_system_ids = idea.active_scoring_system_ids %>
      <% form_scoring_systems = scoring_user.available_scoring_systems %>
      <% legacy_scoring_system = form_scoring_systems.find { |system| system['kind'] == 'legacy_weighted' } %>
      <% scorecard_systems = form_scoring_systems.select { |system| system['kind'] == 'criterion_scorecard' } %>
      <% weights = scoring_user.scoring_weights %>
      <div class="form-panel scoring-section"
           <% if legacy_scoring_system %>
             data-controller="score"
             data-score-trl-weight-value="<%= weights['trl'] %>"
             data-score-difficulty-weight-value="<%= weights['difficulty'] %>"
             data-score-opportunity-weight-value="<%= weights['opportunity'] %>"
             data-score-timing-weight-value="<%= weights['timing'] %>"
           <% end %>>
        <h3 class="form-panel-title">Scoring</h3>

        <% if legacy_scoring_system %>
          <div class="scoring-grid"
               data-template-switch-target="scoringSystem"
               data-scoring-system-id="<%= legacy_scoring_system['id'] %>"
               <%= "hidden" unless active_scoring_system_ids.include?(legacy_scoring_system['id']) %>>
            <div class="score-item">
              <div class="score-item-header">
                <label class="score-label score-tooltip">
                  TRL
                  <span class="tooltip-text">Technology Readiness Level (0=concept, 10=proven)</span>
                </label>
                <span class="score-value trl" data-score-target="trlValue"><%= idea.trl || 0 %></span>
              </div>
              <%= form.range_field :trl,
                  min: 0, max: 10, step: 1,
                  value: idea.trl || 0,
                  class: "score-slider trl",
                  data: { score_target: "trlSlider", action: "input->score#updateTrl" } %>
              <div class="score-range"><span>Concept</span><span>Proven</span></div>
            </div>

            <div class="score-item">
              <div class="score-item-header">
                <label class="score-label score-tooltip">
                  Difficulty
                  <span class="tooltip-text">Execution difficulty (0=easy, 10=extremely hard)</span>
                </label>
                <span class="score-value difficulty" data-score-target="difficultyValue"><%= idea.difficulty || 0 %></span>
              </div>
              <%= form.range_field :difficulty,
                  min: 0, max: 10, step: 1,
                  value: idea.difficulty || 0,
                  class: "score-slider difficulty",
                  data: { score_target: "difficultySlider", action: "input->score#updateDifficulty" } %>
              <div class="score-range"><span>Easy</span><span>Extreme</span></div>
              <%= form.text_area :difficulty_explanation,
                  placeholder: "Why this score?",
                  class: "score-explanation",
                  data: { score_target: "difficultyExplanation", action: "input->score#debouncedSave" } %>
            </div>

            <div class="score-item">
              <div class="score-item-header">
                <label class="score-label score-tooltip">
                  Opportunity
                  <span class="tooltip-text">Market opportunity size (0=small, 10=huge)</span>
                </label>
                <span class="score-value opportunity" data-score-target="opportunityValue"><%= idea.opportunity || 0 %></span>
              </div>
              <%= form.range_field :opportunity,
                  min: 0, max: 10, step: 1,
                  value: idea.opportunity || 0,
                  class: "score-slider opportunity",
                  data: { score_target: "opportunitySlider", action: "input->score#updateOpportunity" } %>
              <div class="score-range"><span>Small</span><span>Huge</span></div>
              <%= form.text_area :opportunity_explanation,
                  placeholder: "Why this score?",
                  class: "score-explanation",
                  data: { score_target: "opportunityExplanation", action: "input->score#debouncedSave" } %>
            </div>

            <div class="score-item">
              <div class="score-item-header">
                <label class="score-label score-tooltip">
                  Timing
                  <span class="tooltip-text">Market timing (0=poor, 10=perfect)</span>
                </label>
                <span class="score-value timing" data-score-target="timingValue"><%= idea.timing || 0 %></span>
              </div>
              <%= form.range_field :timing,
                  min: 0, max: 10, step: 1,
                  value: idea.timing || 0,
                  class: "score-slider timing",
                  data: { score_target: "timingSlider", action: "input->score#updateTiming" } %>
              <div class="score-range"><span>Poor</span><span>Perfect</span></div>
              <%= form.text_area :timing_explanation,
                  placeholder: "Why this score?",
                  class: "score-explanation",
                  data: { score_target: "timingExplanation", action: "input->score#debouncedSave" } %>
            </div>
          </div>
        <% end %>

        <% scorecard_systems.each do |system| %>
          <% breakdown = idea.scoring_breakdown_for(system) %>
          <div class="scorecard-form-system"
               data-template-switch-target="scoringSystem"
               data-scoring-system-id="<%= system['id'] %>"
               <%= "hidden" unless active_scoring_system_ids.include?(system['id']) %>>
            <div class="scorecard-form-system__header">
              <h4><%= system['name'] %></h4>
              <% if breakdown[:blocks_work] %>
                <span>
                  Threshold <%= number_with_precision(breakdown[:work_threshold_total], precision: 0) %>/<%= breakdown[:max_total] %>
                </span>
              <% end %>
            </div>
            <div class="scorecard-form-grid">
              <% system['criteria'].each do |criterion| %>
                <% value = idea.scorecard_value_for(system['id'], criterion['key']).presence || system['scale_min'] %>
                <label class="scorecard-form-field" for="idea_scoring_<%= system['id'] %>_<%= criterion['key'] %>">
                  <span><%= criterion['label'] %></span>
                  <%= select_tag "idea[metadata][#{Idea::SCORE_METADATA_KEY}][#{system['id']}][#{criterion['key']}]",
                      options_for_select((system['scale_min'].to_i..system['scale_max'].to_i).map { |score| [score, score] }, value.to_i),
                      id: "idea_scoring_#{system['id']}_#{criterion['key']}",
                      class: "form-control form-control--sm" %>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="computed-score-display" <%= 'data-score-target="computedScore"' if legacy_scoring_system %>>
          <div class="computed-score-label">Computed Score</div>
          <div class="computed-score-value" <%= 'data-score-target="computedScore"' if legacy_scoring_system %>>
            <%= number_with_precision(idea.computed_score || 0, precision: 2) %>
          </div>
          <% if legacy_scoring_system %>
            <div class="score-formula" data-score-target="scoreFormula">
              <%= scoring_user.scoring_formula_display %>
            </div>
          <% elsif scorecard_systems.any? %>
            <div class="score-formula">
              <%= scorecard_systems.map { |system| idea.scoring_breakdown_for(system)[:normalized] }.map { |score| "#{number_with_precision(score, precision: 2)}/10" }.to_sentence %>
            </div>
          <% end %>
        </div>
      </div>

      <% ocr_parts = idea.persisted? ? idea.ocr_attachment_parts : [] %>
      <aside class="form-panel idea-form-ocr-sidebar" aria-label="Extracted attachment parts">
        <details <%= "open" if ocr_parts.present? %>>
          <summary>Extracted parts <span><%= ocr_parts.size %></span></summary>
          <% if ocr_parts.present? %>
            <ul>
              <% ocr_parts.each do |part| %>
                <li>
                  <strong><%= part[:attachment].filename %></strong>
                  <span><%= part[:text] %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p>Upload a document or image and local OCR will extract likely parts here.</p>
          <% end %>
        </details>
      </aside>

      <!-- Form Actions -->
      <div class="form-panel">
        <div style="display:flex;flex-direction:column;gap:10px;">
          <% submit_label = (idea.new_record? || idea.draft?) ? "Create Idea" : "Update Idea" %>
          <% cancel_path = (idea.new_record? || idea.draft?) ? ideas_path : idea_path(idea) %>
          <%= form.submit submit_label, class: "btn btn-primary", style: "width:100%;justify-content:center;" %>
          <%= link_to "Cancel", cancel_path, class: "btn", style: "width:100%;justify-content:center;" %>
        </div>
      </div>

    </div>
  </div>

  <dialog class="attachment-viewer-modal"
          data-action="click->attachment-viewer#backdropClose">
    <div class="attachment-viewer-modal__inner">
      <div class="attachment-viewer-modal__preview" data-attachment-viewer-target="preview"></div>

      <div class="attachment-viewer-modal__fields">
        <div class="form-group">
          <label class="form-label">Filename</label>
          <input type="text" class="form-control" data-attachment-viewer-target="filenameInput">
        </div>

        <div class="form-group">
          <label class="form-label">Replace file</label>
          <input type="file" class="form-control" data-attachment-viewer-target="fileInput">
        </div>
      </div>

      <div class="attachment-viewer-modal__actions">
        <button type="button" class="btn btn-danger" data-attachment-viewer-target="deleteBtn" data-action="click->attachment-viewer#confirmDelete">Delete</button>
        <button type="button" class="btn btn-primary" data-action="click->attachment-viewer#save">Save</button>
        <button type="button" class="btn" data-action="click->attachment-viewer#close">Cancel</button>
      </div>
    </div>
  </dialog>

</div>

<!-- ===== Image Editor Modal ===== -->
<div data-controller="image-editor" class="image-editor" style="display:none">
  <div class="image-editor__backdrop" data-action="click->image-editor#cancel"></div>
  <div class="image-editor__dialog">

    <div class="image-editor__header">
      <span class="image-editor__title">Edit Image</span>
      <button type="button" class="image-editor__close" data-action="click->image-editor#cancel" title="Close">&times;</button>
    </div>

    <div class="image-editor__toolbar">
      <div class="image-editor__tool-group">
        <button type="button" class="image-editor__tool" data-image-editor-target="paintBtn" data-action="click->image-editor#selectPaint" title="Paint">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.06 11.9l8.07-8.06a2.85 2.85 0 114.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 00-3-3.02z"/></svg>
        </button>
        <button type="button" class="image-editor__tool" data-image-editor-target="cropBtn" data-action="click->image-editor#selectCrop" title="Crop">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2v14a2 2 0 002 2h14"/><path d="M18 22V8a2 2 0 00-2-2H2"/></svg>
        </button>
      </div>

      <div class="image-editor__tool-group image-editor__brush-controls">
        <label>Size</label>
        <input type="range" min="1" max="40" value="4" class="image-editor__brush-size" data-image-editor-target="brushSize" data-action="input->image-editor#updateBrushSize">
        <span class="image-editor__size-label" data-image-editor-target="sizeLabel">4px</span>
        <input type="color" value="#e04040" class="image-editor__color-input" data-image-editor-target="brushColor" title="Brush color">
      </div>

      <div class="image-editor__tool-group image-editor__tool-group--end">
        <button type="button" class="image-editor__tool" data-action="click->image-editor#undo" title="Undo (Ctrl+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        </button>
        <button type="button" class="image-editor__tool" data-action="click->image-editor#reset" title="Reset to original">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
      </div>
    </div>

    <div class="image-editor__canvas-area">
      <canvas data-image-editor-target="canvas"></canvas>
      <div class="image-editor__crop-actions" data-image-editor-target="cropActions" style="display:none">
        <button type="button" class="btn btn-sm" data-action="click->image-editor#cancelCrop">Discard</button>
        <button type="button" class="btn btn-primary btn-sm" data-action="click->image-editor#applyCrop">Apply Crop</button>
      </div>
    </div>

    <div class="image-editor__footer">
      <span class="image-editor__hint" data-image-editor-target="hint">Select a tool to edit, or add as-is</span>
      <div class="image-editor__actions">
        <button type="button" class="btn" data-action="click->image-editor#cancel">Cancel</button>
        <button type="button" class="btn btn-primary" data-action="click->image-editor#add">Add Image</button>
      </div>
    </div>

  </div>
</div>
