<div class="idea-card">
  <%= link_to idea_path(idea), class: "idea-card-link", data: { turbo_frame: "_top" } do %>
    <div class="idea-card-header">
      <h3 class="idea-title"><%= idea.title %></h3>
    </div>

    <div class="idea-meta">
      <span class="idea-state <%= idea.state %>"><%= idea.state == "idea_new" ? "New" : idea.state.humanize %></span>
      <% idea.topologies.each do |topology| %>
        <span class="topology-badge" style="--badge-color: <%= topology.color || 'var(--accent)' %>">
          <span class="topology-color-dot" style="background-color: <%= topology.color || 'var(--accent)' %>"></span>
          <%= topology.name %>
        </span>
      <% end %>
      <span class="idea-score">
        <%= idea.computed_score ? number_with_precision(idea.computed_score, precision: 1) : "—" %>
      </span>
    </div>
  <% end %>

  <% entry_tabs = User::IDEA_ENTRY_TABS.select { |tab| @user&.idea_tab_enabled?(tab) } %>
  <% if entry_tabs.any? %>
    <div class="idea-card-entry-panel idea-card-entry-panel--list">
      <% entry_tabs.each do |kind| %>
        <%= render "idea_entries/card_summary", idea: idea, kind: kind %>
      <% end %>
    </div>
  <% end %>

  <div class="idea-actions">
    <%= link_to edit_idea_path(idea), class: "btn btn-sm", data: { turbo_frame: "_top" } do %>
      Edit
    <% end %>
    <%= link_to idea_path(idea), method: :delete,
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "btn btn-sm btn-danger" do %>
      Delete
    <% end %>
  </div>
</div>
