<div class="idea-card idea-card--<%= idea.state %>"
     data-idea-context-menu-target="idea"
     data-action="contextmenu->idea-context-menu#open"
     data-idea-id="<%= idea.id %>"
     data-idea-title="<%= idea.title %>"
     data-idea-list-ids="<%= idea_context_list_ids(idea) %>">

  <div class="idea-card-state-accent"></div>

  <%= link_to idea_path(idea), class: "idea-card-link", data: { turbo_frame: "_top" } do %>
    <div class="idea-card-inner">
      <div class="idea-card-top">
        <h3 class="idea-title"><%= idea.title %></h3>
        <% if idea.computed_score %>
          <span class="idea-card-score"><%= number_with_precision(idea.computed_score, precision: 1) %></span>
        <% end %>
      </div>

      <% if idea.tldr.present? %>
        <p class="idea-card-tldr"><%= idea.tldr %></p>
      <% end %>

      <div class="idea-card-footer">
        <span class="idea-state <%= idea.state %>"><%= idea.state == "idea_new" ? "New" : idea.state.humanize %></span>
        <% if idea.topologies.any? %>
          <div class="idea-card-tags">
            <% idea.topologies.each do |topology| %>
              <span class="topology-badge" style="--badge-color: <%= topology.color || 'var(--accent)' %>">
                <span class="topology-color-dot" style="background-color: <%= topology.color || 'var(--accent)' %>"></span>
                <%= topology.name %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% entry_kinds = (idea.user&.enabled_idea_tabs || []) & User::IDEA_ENTRY_TABS %>
  <% if entry_kinds.any? %>
    <%
      card_entries =
        if idea.association(:idea_entries).loaded?
          idea.idea_entries.select { |e| entry_kinds.include?(e.kind) }
        else
          idea.idea_entries.where(kind: entry_kinds).to_a
        end
    %>
    <% if card_entries.any? %>
      <div class="idea-card-structured-entries">
        <% entry_kinds.each do |kind| %>
          <%= render "idea_entries/card_summary", idea: idea, kind: kind, inline: true %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
