<div class="form-container">
  <div class="form-container-header">
    <h2><%= @idea.draft? ? "New Idea" : "Edit Idea" %></h2>
    <p class="form-container-subtitle"><%= @idea.draft? ? "Capture and score a new concept" : @idea.title %></p>
  </div>

  <% prompt_with_existing_content = @idea.persisted? && !@idea.draft? %>
  <% draft_storage_key = prompt_with_existing_content ? "idea-edit-draft:v1:user-#{@user.id}:idea-#{@idea.id}" : "idea-draft:v1:user-#{@user.id}" %>
  <%= form_with model: @idea,
        local: true,
        data: {
          controller: "idea-draft-persist",
          action: "input->idea-draft-persist#queueSave change->idea-draft-persist#queueSave submit->idea-draft-persist#submit",
          idea_draft_persist_enabled_value: true,
          idea_draft_persist_storage_key_value: draft_storage_key,
          idea_draft_persist_unlock_seed_value: @user.idea_draft_unlock_seed,
          idea_draft_persist_prompt_with_existing_content_value: prompt_with_existing_content,
          idea_draft_persist_prompt_delay_value: 6000
        }.compact do |form| %>
    <%= render 'form', form: form, idea: @idea, lists: @lists, named_lists: @named_lists, topologies: @topologies %>
  <% end %>
</div>

<%= stylesheet_link_tag "excalidraw_app/index" %>
<%= javascript_include_tag "excalidraw_app/index", defer: true, type: "module" %>
