<div class="ideas-container"
     data-controller="idea-context-menu infinite-scroll"
     data-idea-context-menu-add-url-template-value="/ideas/__IDEA_ID__/add_to_list"
     data-idea-context-menu-kanban-boards-value="<%= idea_context_kanban_boards_json(@kanban_boards) %>"
     data-idea-context-menu-named-lists-value="<%= idea_context_named_lists_json(@named_lists) %>">
  <div class="page-header">
    <h2>Ideas</h2>
    <div class="header-actions">
      <div class="view-toggle-group">
        <button type="button" class="btn btn-sm" data-view-toggle="grid" title="Grid view" aria-label="Grid view">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
        <button type="button" class="btn btn-sm" data-view-toggle="list" title="List view" aria-label="List view">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
      <% pending_intake_count = @user&.submissions&.pending&.count || 0 %>
      <%= link_to ideas_intake_path, class: "btn" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Intake
        <% if pending_intake_count > 0 %>
          <span class="nav-badge"><%= pending_intake_count %></span>
        <% end %>
      <% end %>
      <%= link_to new_idea_path, class: "btn btn-primary" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Idea
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "ideas_filters" do %>
    <%= render 'filters' %>
  <% end %>

  <%= turbo_frame_tag "ideas_list" do %>
    <% if @theme_groups %>
      <div class="theme-groups" data-controller="collapsible-groups" data-collapsible-groups-key-value="ideas-theme-groups">
        <div class="theme-toolbar">
          <span><%= "#{pluralize(@theme_groups.count { |t, _| t }, 'theme')} in view" if @themes.any? %></span>
          <%= link_to "Manage themes", settings_themes_path, data: { turbo_frame: "_top" } %>
        </div>
        <% if @themes.empty? && @theme_groups.any? %>
          <div class="theme-hint">
            <strong>Nothing to group yet</strong>
            Add a theme to an idea to group it here. Open an idea, type a theme under Themes, press Enter.
          </div>
        <% end %>
        <% @theme_groups.each do |theme, ideas| %>
          <details class="theme-group<%= ' theme-group--none' unless theme %>" open <%= tag.attributes(style: ("--theme-color: #{theme.color}" if theme&.color.present?)) %> data-collapsible-groups-target="group" data-group-id="<%= theme&.id || 'none' %>"
                   data-action="toggle->collapsible-groups#save">
            <summary class="theme-group__header">
              <span class="theme-group__mark" aria-hidden="true"></span>
              <span class="theme-group__name"><%= theme&.name || "No theme" %></span>
              <span class="theme-group__count"><%= pluralize(ideas.size, "idea") %></span>
              <span class="theme-group__chev" aria-hidden="true">▾</span>
            </summary>
            <div class="ideas-grid">
              <% ideas.each do |idea| %>
                <%= render 'idea_card', idea: idea %>
              <% end %>
            </div>
          </details>
        <% end %>
        <% if @theme_groups.empty? %>
          <div class="empty-state">
            <h3>No ideas found</h3>
            <p>Adjust your filters or forge a new idea.</p>
            <%= link_to "Create Idea", new_idea_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="ideas-grid" id="ideas-grid">
        <% @ideas.each do |idea| %>
          <%= render 'idea_card', idea: idea %>
        <% end %>

        <% if @ideas.empty? %>
          <div class="empty-state" style="grid-column: 1 / -1;">
            <h3>No ideas found</h3>
            <p>Adjust your filters or forge a new idea.</p>
            <%= link_to "Create Idea", new_idea_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>

      <%= render 'infinite_scroll_sentinel', ideas: @ideas %>
    <% end %>
  <% end %>
</div>

<script>
(function() {
  function applyView() {
    var container = document.querySelector('.ideas-container');
    if (!container) return;
    var view = localStorage.getItem('ideas-view') || 'list';
    container.dataset.view = view;
    document.querySelectorAll('[data-view-toggle]').forEach(function(btn) {
      btn.classList.toggle('active', btn.dataset.viewToggle === view);
    });
  }

  applyView();
  document.addEventListener('turbo:frame-render', applyView);

  if (!document.__ideaViewToggle) {
    document.__ideaViewToggle = true;
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-view-toggle]');
      if (!btn) return;
      var view = btn.dataset.viewToggle;
      var container = document.querySelector('.ideas-container');
      if (container) container.dataset.view = view;
      localStorage.setItem('ideas-view', view);
      document.querySelectorAll('[data-view-toggle]').forEach(function(b) {
        b.classList.toggle('active', b.dataset.viewToggle === view);
      });
    });
  }
})();
</script>
