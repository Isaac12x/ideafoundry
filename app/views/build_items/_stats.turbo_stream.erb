<% if defined?(@total_display) && @total_display
     queued_count = @queued_display
     done_count = @done_display
     total_count = @total_display
   else
     pending_items = @user.build_items.pending.to_a
     done_items = @user.build_items.done.to_a
     subitems = BuildItem.subitem_totals(pending_items + done_items)
     done_count = done_items.size + subitems[:done]
     queued_count = pending_items.size + (subitems[:total] - subitems[:done])
     total_count = done_count + queued_count
   end %>

<%= turbo_stream.replace "backlog_queued_count" do %>
  <span class="backlog-stat-num" id="backlog_queued_count"><%= queued_count %></span>
<% end %>

<%= turbo_stream.replace "backlog_done_count" do %>
  <span class="backlog-stat-num" id="backlog_done_count"><%= done_count %></span>
<% end %>

<%= turbo_stream.replace "backlog_progress_wrapper" do %>
  <div id="backlog_progress_wrapper">
    <% if total_count > 0 %>
      <div class="backlog-progress">
        <div class="backlog-progress-track">
          <div class="backlog-progress-fill" style="width: <%= (done_count.to_f / total_count * 100).round %>%"></div>
        </div>
        <span class="backlog-progress-label"><%= (done_count.to_f / total_count * 100).round %>%</span>
      </div>
    <% end %>
  </div>
<% end %>
