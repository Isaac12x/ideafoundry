<% show_existing = local_assigns.fetch(:show_existing, false) %>

<div class="backlog-form-images"
     data-controller="dropzone"
     data-dropzone-multiple-value="true"
     data-dropzone-accept-value="image/*">
  <div class="backlog-form-images-header">
    <span class="backlog-form-links-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      Images
    </span>
  </div>
  <%= render "build_items/image_strip", build_item: build_item if show_existing %>
  <div class="dropzone backlog-image-dropzone" data-dropzone-target="zone" data-action="click->dropzone#click dragover->dropzone#dragover dragenter->dropzone#dragenter dragleave->dropzone#dragleave drop->dropzone#drop">
    <div class="dropzone__label" data-dropzone-target="placeholder">
      <span>Drag images here or <strong>browse</strong></span>
    </div>
    <div class="dropzone__preview-grid" data-dropzone-target="preview"></div>
  </div>
  <%= form.file_field :images, multiple: true, accept: "image/*", style: "display:none", data: { dropzone_target: "input" } %>
</div>
