<% pending_items = idea.todo_items.pending %>
<% completed_items = idea.todo_items.done %>
<% total = pending_items.size + completed_items.size %>

<div class="todo-tab" id="todo_tab_<%= idea.id %>">
  <% if total > 0 %>
    <% pct = (completed_items.size.to_f / total * 100).round %>
    <div class="todo-progress-mini">
      <span class="todo-progress-label"><%= completed_items.size %>/<%= total %></span>
      <div class="todo-progress-track">
        <div class="todo-progress-fill" style="width: <%= pct %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="todo-add-section" id="todo_form_<%= idea.id %>">
    <%= render "todo_items/form", idea: idea %>
  </div>

  <% if pending_items.any? %>
    <div class="todo-section-label">
      <span>To do</span>
    </div>
  <% end %>

  <div class="todo-list" id="todo_pending_<%= idea.id %>"
       data-controller="todo-sort"
       data-todo-sort-url-value="<%= reorder_idea_todo_items_path(idea) %>">
    <% pending_items.each do |item| %>
      <%= render "todo_items/todo_item", todo_item: item %>
    <% end %>

    <% if pending_items.empty? && completed_items.empty? %>
      <div class="todo-empty" id="todo_empty_<%= idea.id %>">
        <div class="todo-empty-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <p>No tasks yet</p>
        <span class="todo-empty-hint">Add your first task above to get started</span>
      </div>
    <% end %>
  </div>

  <% if completed_items.any? %>
    <div class="todo-completed-section" data-controller="completed-toggle">
      <button class="todo-completed-toggle" data-action="click->completed-toggle#toggle">
        <svg class="chevron-icon" data-completed-toggle-target="icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        <span>Completed</span>
        <span class="todo-completed-count"><%= completed_items.size %></span>
      </button>
      <div class="completed-items" data-completed-toggle-target="list" id="todo_completed_<%= idea.id %>">
        <% completed_items.each do |item| %>
          <%= render "todo_items/todo_item", todo_item: item %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
