<dialog class="attachment-viewer-modal"
        data-attachment-viewer-target="dialog"
        data-action="click->attachment-viewer#backdropClose close->attachment-viewer#reset">
  <div class="attachment-viewer-modal__inner">
    <header class="attachment-viewer-modal__head">
      <h4 class="attachment-viewer-modal__title" data-attachment-viewer-target="title"></h4>
      <button type="button" class="attachment-viewer-modal__close" aria-label="Close"
              data-action="click->attachment-viewer#close">&times;</button>
    </header>

    <div class="attachment-viewer-modal__preview" data-pdf-scroller data-attachment-viewer-target="preview"></div>

    <details class="attachment-viewer-modal__fields">
      <summary>File details</summary>
      <div class="form-group">
        <label class="form-label" for="attachment_viewer_filename">Filename</label>
        <input type="text" id="attachment_viewer_filename" class="form-control" data-attachment-viewer-target="filenameInput">
      </div>

      <div class="form-group">
        <label class="form-label" for="attachment_viewer_file">Replace file</label>
        <input type="file" id="attachment_viewer_file" class="form-control" data-attachment-viewer-target="fileInput">
      </div>

      <div class="attachment-viewer-modal__save">
        <button type="button" class="btn btn-primary btn-sm" data-action="click->attachment-viewer#save">Save changes</button>
      </div>
    </details>

    <div class="attachment-viewer-modal__actions">
      <button type="button" class="attachment-viewer-modal__danger" data-attachment-viewer-target="deleteBtn" data-action="click->attachment-viewer#confirmDelete">Delete</button>
      <a class="attachment-viewer-modal__download" download data-attachment-viewer-target="downloadLink">Download</a>
    </div>
  </div>
</dialog>
