<div class="submission-detail-container submission-import-container">
  <div class="submission-header">
    <div class="submission-header-top">
      <%= link_to submissions_path, class: "btn btn-sm" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back
      <% end %>
    </div>

    <div class="submission-header-content">
      <h1 class="submission-detail-title">Batch Import</h1>
      <div class="submission-header-meta">
        <span class="submission-timestamp">Apple Notes, Notion, Google Keep, and Evernote</span>
      </div>
    </div>
  </div>

  <div class="submission-import-panel">
    <%= form_with url: preview_submission_import_path, method: :post, class: "submission-import-form" do %>
      <%= hidden_field_tag :source, "apple_notes" %>

      <div class="submission-import-source-row">
        <div>
          <h2>Apple Notes</h2>
          <p>Find the local Apple Notes database on this Mac and preview folders and notes before importing.</p>
        </div>

        <%= submit_tag "Find Notes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="submission-import-panel submission-import-panel-spaced">
    <div class="submission-import-cloud-list">
      <% @source_options.except("apple_notes").each do |source, label| %>
        <div class="submission-import-source-row">
          <div>
            <h2><%= label %></h2>
            <p>Connect with OAuth, then choose the pages or notes to import.</p>
          </div>

          <%= link_to "Connect", oauth_submission_import_path(source: source), class: "btn" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
