<% mode = local_assigns.fetch(:mode, :unlock) %>
<% phrase = local_assigns.fetch(:phrase, VoiceFingerprint::CANONICAL_PHRASE) %>
<% variants = Array(local_assigns[:variants]).presence || VoiceFingerprint::SETUP_VARIANTS %>
<% return_to = local_assigns[:return_to].presence || root_path %>
<% error = local_assigns[:error] %>
<% opening = local_assigns.fetch(:opening, false) %>
<% redirect_url = local_assigns[:redirect_url].presence || return_to %>

<section class="typing-lock-shell voice-id-shell<%= " voice-id-shell--opening" if opening %>"
         data-controller="voice-id"
         data-voice-id-mode-value="<%= mode %>"
         data-voice-id-phrase-value="<%= phrase %>"
         data-voice-id-redirect-url-value="<%= redirect_url %>"
         data-voice-id-transcribe-url-value="<%= transcribe_voice_id_typing_lock_path %>">
  <div class="typing-lock-topline">
  </div>

  <% if opening %>
    <div class="voice-lock-fort voice-lock-fort--opening" aria-live="polite">
      <div class="voice-lock-fort__panel voice-lock-fort__panel--top"></div>
      <div class="voice-lock-fort__panel voice-lock-fort__panel--bottom"></div>
      <div class="voice-lock-fort__lock" aria-label="Unlocked Voice ID lock"></div>
      <div class="voice-lock-fort__reveal">
        <h2>Voice ID matched</h2>
        <p>The fort is opening.</p>
      </div>
    </div>
  <% else %>
    <div class="typing-lock-heading">
      <h2><%= mode == :enroll ? "Set up Voice ID" : "Test Your Speech" %></h2>
      <% if mode == :enroll %>
        <p>Say each phrase below once. Press record, speak clearly, then record the next one.</p>
      <% else %>
        <p style="text-align: right;">Please say out loud the following sentence.</p>
      <% end %>
    </div>

    <blockquote class="voice-id-phrase">“<%= phrase %>”</blockquote>

    <% if mode == :enroll %>
      <ol class="voice-id-variants">
        <% variants.each do |variant| %>
          <li data-voice-id-target="variantItem"><%= variant %></li>
        <% end %>
      </ol>
    <% end %>

    <%= form_with url: (mode == :enroll ? voice_id_enrollment_path : verify_voice_id_typing_lock_path),
          method: :post,
          local: true,
          class: "voice-id-form",
          data: { turbo: false, voice_id_target: "form" } do %>
      <%= hidden_field_tag :return_to, return_to %>
      <%= hidden_field_tag :voice_payload, "{}", data: { voice_id_target: "payload" } %>

      <% if mode == :enroll %>
        <div data-voice-id-target="samples"></div>
        <% variants.each_with_index do |variant, index| %>
          <%= hidden_field_tag "voice_id_samples[][transcript]", "", data: { voice_id_target: "sampleTranscript", voice_id_variant: variant, voice_id_index: index } %>
          <%= hidden_field_tag "voice_id_samples[][duration_ms]", "", data: { voice_id_target: "sampleDuration", voice_id_index: index } %>
          <%= hidden_field_tag "voice_id_samples[][rms]", "", data: { voice_id_target: "sampleRms", voice_id_index: index } %>
        <% end %>
      <% else %>
        <%= hidden_field_tag :captured_voice_transcript, "", data: { voice_id_target: "transcript" } %>
      <% end %>

      <p class="voice-id-status" data-voice-id-target="status" aria-live="polite">
        <%= mode == :enroll ? "Press record and say the phrase." : "Press the \"I'm ready\" button when you're ready to speak." %>
      </p>

      <% if error.present? %>
        <p class="typing-authenticator-error" role="alert"><%= error %></p>
      <% end %>

      <div class="typing-lock-actions">
        <% if mode == :enroll %>

          <button type="button" class="btn btn-secondary" data-action="voice-id#record" data-voice-id-target="recordBtn">
            Record phrase
          </button>
          <%= submit_tag "Save Voice ID",
                class: "btn btn-primary",
                disabled: true,
                data: { voice_id_target: "submitBtn" } %>

        <% else %>

        <div>
          <button type="button" class="btn btn-primary" data-action="voice-id#record" data-voice-id-target="recordBtn">
            I'm ready
          </button>
        </div>
        <% end %>
      </div>

      <% unless mode == :enroll %>
        <p class="typing-lock-noscript">
          If local microphone capture is unavailable, enter the spoken transcript manually for local development:
          <%= text_field_tag :voice_transcript,
                "",
                class: "typing-authenticator-input",
                placeholder: phrase,
                data: { voice_id_target: "manualTranscript" } %>
        </p>
      <% end %>
    <% end %>
  <% end %>
</section>
