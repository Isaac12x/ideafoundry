<%
  keyboard_rows = [
    %w[` 1 2 3 4 5 6 7 8 9 0 - = Backspace],
    %w[Tab q w e r t y u i o p [ ] \\],
    ['Caps', 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', "'", 'Enter'],
    ['Shift', 'z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.', '/', 'Shift'],
    ['Ctrl', 'Alt', 'Space', 'Alt', 'Ctrl']
  ]
  result = local_assigns[:result].presence&.to_sym
  redirect_url = local_assigns[:redirect_url].presence
  transitioning = mode == :unlock && result == :matched
  decoy_score = mode == :unlock && result == :missed
  result_state = {
    matched: {
      label: "Fingerprint matched",
      modifier: "matched"
    }
  }[result]
%>

<section class="typing-lock-shell<%= " typing-lock-shell--transitioning" if transitioning %>"
         data-controller="typing-fingerprint"
         data-typing-fingerprint-mode-value="<%= mode %>"
         data-typing-fingerprint-text-value="<%= text %>"
         data-typing-fingerprint-min-samples-value="<%= min_samples %>"
         data-typing-fingerprint-result-value="<%= result %>"
         data-typing-fingerprint-redirect-url-value="<%= redirect_url %>">
  <% if transitioning %>
    <div class="typing-lock-transition">
      <div class="typing-lock-animation typing-lock-animation--<%= result_state[:modifier] %>"
           data-controller="typing-unlock-animation"
           data-typing-unlock-animation-url-value="<%= asset_path('typing_unlock_animation/index.js') %>"
           data-typing-unlock-animation-result-value="<%= result_state[:modifier] %>"
           role="status"
           aria-live="assertive"
           aria-label="<%= result_state[:label] %>">
        <div class="typing-lock-animation__canvas"
             data-typing-unlock-animation-target="canvas"
             aria-hidden="true"></div>
        <span class="typing-lock-animation__status"><%= result_state[:label] %></span>
      </div>
    </div>
  <% else %>
    <div class="typing-lock-topline">
      <span class="typing-lock-mark">Idea Foundry</span>
      <span><%= mode == :enroll ? "Fingerprint setup" : "Score check" %></span>
    </div>

    <div class="typing-lock-heading">
      <h2><%= title %></h2>
      <p><%= subtitle %></p>
    </div>

    <%= form_with url: form_url,
          method: :post,
          local: true,
          class: "typing-lock-form",
          data: {
            turbo: false,
            typing_fingerprint_target: "form",
            action: "submit->typing-fingerprint#submit"
          } do %>
      <%= hidden_field_tag :challenge_id, challenge_id %>
      <%= hidden_field_tag :return_to, return_to %>
      <%= hidden_field_tag :timing_payload, "", data: { typing_fingerprint_target: "payload" } %>

      <div class="typing-lock-prompt" data-typing-fingerprint-target="prompt" aria-live="polite"></div>

      <%= text_area_tag :typed_text,
            nil,
            class: "typing-lock-input",
            rows: mode == :enroll ? 4 : 2,
            autocomplete: "off",
            autocapitalize: "off",
            spellcheck: false,
            placeholder: mode == :enroll ? "Type the full passage here" : "Type the passage here",
            data: {
              typing_fingerprint_target: "input",
              action: "keydown->typing-fingerprint#keydown keyup->typing-fingerprint#keyup input->typing-fingerprint#input paste->typing-fingerprint#paste"
            } %>

      <p class="typing-lock-decoy<%= " is-visible" if decoy_score %>"
         data-typing-fingerprint-target="decoy"
         role="status"
         aria-live="polite"
         <%= "hidden" unless decoy_score %>>This is your score</p>

      <div class="typing-lock-progress" aria-hidden="true">
        <span data-typing-fingerprint-target="progressBar"></span>
      </div>

      <div class="typing-keyboard" aria-hidden="true">
        <% keyboard_rows.each do |row| %>
          <div class="typing-keyboard-row">
            <% row.each do |key| %>
              <% data_key = case key
                            when 'Space' then ' '
                            when 'Backspace' then 'Backspace'
                            when 'Enter' then 'Enter'
                            when 'Shift' then 'Shift'
                            when 'Tab' then 'Tab'
                            when 'Caps' then 'CapsLock'
                            else key.downcase
                            end %>
              <span class="typing-key typing-key--<%= key.downcase.gsub(/[^a-z0-9]+/, '-') %>"
                    data-typing-fingerprint-target="key"
                    data-key="<%= data_key %>"
                    <% if key == 'Backspace' %>aria-label="Backspace"<% end %>>
                <% if key == 'Backspace' %>
                  <svg class="typing-key__backspace-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3.5 12l5.2-6.2h11.8v12.4H8.7L3.5 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M11 9l6 6M17 9l-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                <% else %>
                  <%= key %>
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="typing-lock-metrics">
        <div>
          <strong data-typing-fingerprint-target="time">00:00</strong>
          <span>Time</span>
        </div>
        <div>
          <strong data-typing-fingerprint-target="accuracy">100%</strong>
          <span>Accuracy</span>
        </div>
        <div>
          <strong data-typing-fingerprint-target="rhythm">0</strong>
          <span>Samples</span>
        </div>
        <div>
          <strong data-typing-fingerprint-target="lastKey">-</strong>
          <span>Last key</span>
        </div>
      </div>

    <% end %>

    <noscript>
      <p class="typing-lock-noscript"><%= text %></p>
    </noscript>
  <% end %>
</section>
