<% root_notes = idea.notes.roots.recent_first.includes(:replies).to_a %>
<% days = root_notes.group_by { |n| n.created_at.to_date } %>

<div class="notes-tab" id="notes_tab_<%= idea.id %>" data-controller="note-tree">
  <div class="notes-add-section" id="note_form_<%= idea.id %>">
    <%= render "notes/form", idea: idea, parent_note_id: nil %>
  </div>

  <% if root_notes.any? %>
    <div class="notes-tree" id="notes_tree_<%= idea.id %>">
      <% days.each do |day, notes| %>
        <section class="notes-day" aria-label="<%= l(day, format: :long) %>">
          <h3 class="notes-day-label">
            <%= day == Date.current ? "Today" : (day == Date.current - 1 ? "Yesterday" : l(day, format: :long)) %>
          </h3>
          <% notes.each do |note| %>
            <%= render "notes/note", note: note, idea: idea, depth: 0 %>
          <% end %>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="notes-empty" id="notes_empty_<%= idea.id %>">
      <p class="notes-empty-title">Nothing written down yet</p>
      <span class="notes-empty-hint">A finding, a lead, a doubt that needs checking. Short is fine; you can reply to a note to build on it.</span>
    </div>
  <% end %>
</div>
