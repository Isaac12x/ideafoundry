<% root_notes = idea.notes.roots.chronological.includes(:replies) %>
<% total = idea.notes.count %>

<div class="notes-tab" id="notes_tab_<%= idea.id %>" data-controller="note-tree">
  <div class="notes-add-section" id="note_form_<%= idea.id %>">
    <%= render "notes/form", idea: idea, parent_note_id: nil %>
  </div>

  <% if root_notes.any? %>
    <div class="notes-tree" id="notes_tree_<%= idea.id %>">
      <% root_notes.each do |note| %>
        <%= render "notes/note", note: note, idea: idea, depth: 0 %>
      <% end %>
    </div>
  <% else %>
    <div class="notes-empty" id="notes_empty_<%= idea.id %>">
      <div class="notes-empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
      </div>
      <p>No notes yet</p>
      <span class="notes-empty-hint">Capture thoughts as they happen</span>
    </div>
  <% end %>
</div>
