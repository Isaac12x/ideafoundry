<div class="lists-container"
     data-controller="tabs drag idea-context-menu"
     data-tabs-default-tab-value="<%= @default_view %>"
     data-drag-url-value="<%= update_idea_position_lists_path %>"
     data-idea-context-menu-add-url-template-value="/ideas/__IDEA_ID__/add_to_list"
     data-idea-context-menu-kanban-boards-value="<%= idea_context_kanban_boards_json(@kanban_boards) %>"
     data-idea-context-menu-named-lists-value="<%= idea_context_named_lists_json(@named_lists) %>">

  <div class="page-header">
    <div class="header-left">
      <h2>Planning</h2>
    </div>
    <div class="header-actions">
      <div class="view-toggle">
        <button class="view-toggle__btn active" data-tabs-target="tab" data-tab-name="kanban" data-action="click->tabs#switch">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:2px;"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Kanban
        </button>
        <button class="view-toggle__btn" data-tabs-target="tab" data-tab-name="named" data-action="click->tabs#switch">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:2px;"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3" cy="6" r="1"/><circle cx="3" cy="12" r="1"/><circle cx="3" cy="18" r="1"/></svg>
          Named
        </button>
      </div>
    </div>
  </div>

  <div data-tabs-target="panel" data-tab-panel="kanban">
    <div class="kanban-boards">
      <% @kanban_boards.each_with_index do |board, board_index| %>
        <section class="kanban-board" data-kanban-board-id="<%= board.id %>">
          <div class="kanban-board-header">
            <div>
              <h3><%= board.name %></h3>
              <p><%= pluralize(board.lists.size, "column") %></p>
            </div>
            <div class="kanban-board-header-actions">
              <% if @kanban_boards.size > 1 %>
                <%= button_to move_kanban_board_path(board, direction: "up"), method: :patch,
                      class: "btn btn-sm", title: "Move board up", disabled: board_index.zero?,
                      form: { style: "display:inline" } do %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
                <% end %>
                <%= button_to move_kanban_board_path(board, direction: "down"), method: :patch,
                      class: "btn btn-sm", title: "Move board down", disabled: board_index == @kanban_boards.size - 1,
                      form: { style: "display:inline" } do %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                <% end %>
              <% end %>
              <%= link_to new_list_path(kind: "kanban", kanban_board_id: board.id), class: "btn btn-sm btn-primary" do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                New Column
              <% end %>
              <%= button_to kanban_board_path(board), method: :delete,
                    class: "btn btn-sm btn-danger", title: "Delete board",
                    form: { style: "display:inline" },
                    data: { turbo_confirm: "Delete \"#{board.name}\" and its #{pluralize(board.lists.size, 'column')}? Ideas stay in your library." } do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
              <% end %>
            </div>
          </div>

          <div class="lists-grid">
            <% board.lists.each do |list| %>
              <div class="list-container" data-list-kind="kanban">
                <div class="list-header">
                  <h3><%= list.name %></h3>
                  <div class="list-actions">
                    <% if @user.email_configured? %>
                      <%= button_to send_email_list_path(list), method: :post, class: "btn btn-sm btn-email", form: { style: "display: inline" }, data: { turbo_confirm: "Email this list to #{@user.email_recipients.join(', ')}?" } do %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Email
                      <% end %>
                    <% end %>
                    <%= link_to "Edit", edit_list_path(list), class: "btn btn-sm" %>
                    <%= link_to "Delete", list_path(list), method: :delete,
                                data: { turbo_method: :delete, turbo_confirm: "Delete this list?" },
                                class: "btn btn-sm btn-danger" %>
                  </div>
                </div>

                <div class="drop-zone"
                     data-drag-target="container"
                     data-list-id="<%= list.id %>"
                     data-kanban-board-id="<%= board.id %>"
                     id="list_<%= list.id %>_ideas">
                  <%= render 'ideas', list: list, ideas: list.ideas.includes(:idea_lists, :idea_entries).order('idea_lists.position') %>
                </div>
                <div class="kanban-search-section"
                     data-controller="idea-search"
                     data-idea-search-search-url-value="<%= search_ideas_path %>"
                     data-idea-search-add-url-template-value="/ideas/__IDEA_ID__/add_to_list"
                     data-idea-search-list-id-value="<%= list.id %>">
                  <button type="button" class="btn btn-sm kanban-search-toggle" data-action="click->idea-search#toggleSearch">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    Add idea
                  </button>
                  <div class="kanban-search-panel" data-idea-search-target="panel" hidden>
                    <div class="list-search-input-row">
                      <svg class="list-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                      <input type="text"
                             class="form-control"
                             placeholder="Search ideas…"
                             data-idea-search-target="input"
                             data-action="input->idea-search#search"
                             autocomplete="off">
                    </div>
                    <div class="idea-search-results" data-idea-search-target="results" hidden></div>
                  </div>
                </div>
              </div>
            <% end %>

            <% if board.lists.empty? %>
              <div class="empty-state" style="grid-column: 1 / -1;">
                <h3>No columns yet</h3>
                <p>Create a column to start organizing ideas on this board.</p>
                <%= link_to "Create Column", new_list_path(kind: "kanban", kanban_board_id: board.id), class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @kanban_boards.empty? %>
        <div class="empty-state">
          <h3>No kanban boards yet</h3>
          <p>Create a board to start organizing ideas.</p>
        </div>
      <% end %>

      <div class="kanban-board-toolbar kanban-board-toolbar--below">
        <%= form_with model: @kanban_board, url: kanban_boards_path, local: true, class: "inline-list-form kanban-board-form" do |form| %>
          <%= form.text_field :name, class: "form-control", placeholder: "New board name" %>
          <%= form.submit "Create Board", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>

  <div data-tabs-target="panel" data-tab-panel="named" class="hidden">
    <div class="named-lists-grid">
      <% @named_lists.each do |list| %>
        <div class="named-list-card" data-list-kind="named">
          <div class="named-list-card__body">
            <h3><%= list.name %></h3>
            <p><%= pluralize(list.ideas.size, "idea") %></p>
          </div>
          <div class="list-actions">
            <%= link_to "Open", list_path(list), class: "btn btn-sm btn-primary" %>
            <%= link_to "Edit", edit_list_path(list), class: "btn btn-sm" %>
            <%= link_to "Delete", list_path(list), method: :delete,
                        data: { turbo_method: :delete, turbo_confirm: "Delete this list?" },
                        class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      <% end %>

      <% if @named_lists.empty? %>
        <div class="empty-state">
          <h3>No named lists yet</h3>
          <p>Create a named list for shortlists, launch candidates, or any custom collection.</p>
        </div>
      <% end %>
    </div>

    <div class="named-lists-footer">
      <%= link_to new_list_path(kind: "named"), class: "btn" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        New Named List
      <% end %>
    </div>
  </div>
</div>
