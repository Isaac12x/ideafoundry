<div class="form-container">
  <h2>New List</h2>
  
  <%= form_with model: @list, local: true do |form| %>
    <% if @list.errors.any? %>
      <div class="alert alert-error">
        <h4><%= pluralize(@list.errors.count, "error") %> prohibited this list from being saved:</h4>
        <ul>
          <% @list.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :kind, "List Type" %>
      <%= form.select :kind,
          options_for_select([["Kanban column", "kanban"], ["Named list", "named"]], @list.kind),
          {},
          class: "form-control" %>
    </div>

    <% if (@kanban_boards || []).any? %>
      <div class="form-group">
        <%= form.label :kanban_board_id, "Kanban Board" %>
        <%= form.select :kanban_board_id,
            options_from_collection_for_select(@kanban_boards, :id, :name, @list.kanban_board_id || params[:kanban_board_id]),
            {},
            class: "form-control" %>
        <span class="form-text">Used when creating a kanban column.</span>
      </div>
    <% end %>

    <div class="form-actions">
      <%= form.submit "Create List", class: "btn btn-primary" %>
      <%= link_to "Cancel", lists_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
