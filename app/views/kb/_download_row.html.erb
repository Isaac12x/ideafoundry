<div id="<%= dom_id(download) %>" class="kb-async-row kb-download-row kb-download-row--<%= download.status %>">
  <% if download.done? %>
    <%= link_to kb_file_path(src: download.source_index, file: download.file_rel),
          data: { turbo_frame: "kb-content" }, class: "kb-file-link" do %>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      <%= download.filename %>
    <% end %>
  <% elsif download.failed? %>
    <span class="kb-download-failed" title="<%= download.error %>">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <%= truncate(download.label, length: 36) %>
    </span>
  <% else %>
    <span class="kb-download-pending">
      <svg class="kb-download-spinner" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
      <%= truncate(download.label, length: 36) %>
    </span>
  <% end %>
</div>
