<%
  extractable_exts = %w[.pdf .png .jpg .jpeg .webp .tif .tiff]
%>
<% tree.sort.each do |name, node| %>
  <% if node[:type] == :dir %>
    <% favorite = node[:preference]&.favorite? %>
    <div class="kb-dir-group" data-controller="kb-folder">
      <div class="kb-dir-header" draggable="true"
           data-action="contextmenu->kb-tree#show
                        dragstart->kb-tree#dragStart
                        dragend->kb-tree#dragEnd
                        dragover->kb-tree#dragOver
                        dragleave->kb-tree#dragLeave
                        drop->kb-tree#drop"
           data-kb-tree-type-param="dir"
           data-kb-tree-rel-param="<%= node[:rel] %>"
           data-kb-tree-src-param="<%= folder_index %>"
           data-kb-tree-favorite-param="<%= favorite %>">
        <button type="button" class="kb-dir-toggle" data-action="click->kb-folder#toggle" aria-label="Toggle <%= name %>">
          <svg class="kb-folder-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <button type="button" class="kb-entry-icon-button" title="Personalise folder icon"
                aria-label="Personalise <%= name %> icon"
                data-action="click->kb-icon-picker#open"
                data-kb-icon-picker-type-param="folder"
                data-kb-icon-picker-src-param="<%= folder_index %>"
                data-kb-icon-picker-rel-param="<%= node[:rel] %>"
                data-kb-icon-picker-label-param="<%= name %>">
          <%= render "kb/entry_icon",
                preference: node[:preference],
                default_preference: default_folder_preference,
                fallback: "folder" %>
        </button>
        <button type="button"
                class="kb-favorite-button <%= 'is-favorite' if favorite %>"
                aria-label="<%= favorite ? 'Remove from favourites' : 'Add to favourites' %>"
                title="<%= favorite ? 'Remove from favourites' : 'Add to favourites' %>"
                data-action="click->kb-tree#toggleFavorite"
                data-kb-tree-type-param="folder"
                data-kb-tree-src-param="<%= folder_index %>"
                data-kb-tree-rel-param="<%= node[:rel] %>"
                data-kb-tree-favorite-param="<%= favorite %>">
          <%= render "kb/star_icon", filled: favorite %>
        </button>
        <button type="button" class="kb-dir-label" data-action="click->kb-folder#toggle"><%= name %></button>
      </div>
      <div class="kb-dir-children" data-kb-folder-target="files">
        <%= render "kb/tree_node",
              tree: node[:children],
              folder_index: folder_index,
              selected_file: selected_file,
              selected_folder_index: selected_folder_index,
              default_folder_preference: default_folder_preference %>
      </div>
    </div>
  <% elsif node[:type] == :file %>
    <%
      ext = File.extname(node[:rel]).downcase
      is_extractable = extractable_exts.include?(ext)
      is_editable = true
      active = (selected_folder_index == folder_index && selected_file == node[:rel])
      favorite = node[:preference]&.favorite?
      file_url = kb_file_path(file: node[:rel], src: folder_index)
      display_name = File.basename(node[:rel])
    %>
    <div class="kb-file-row <%= 'is-active' if active %>" draggable="true"
         data-action="contextmenu->kb-tree#show dragstart->kb-tree#dragStart dragend->kb-tree#dragEnd"
         data-kb-tree-type-param="file"
         data-kb-tree-rel-param="<%= node[:rel] %>"
         data-kb-tree-src-param="<%= folder_index %>"
         data-kb-tree-extractable-param="<%= is_extractable %>"
         data-kb-tree-editable-param="<%= is_editable %>"
         data-kb-tree-favorite-param="<%= favorite %>">
      <span class="kb-file-type-icon"><%= render "kb/file_icon", extension: ext %></span>
      <button type="button"
              class="kb-favorite-button <%= 'is-favorite' if favorite %>"
              aria-label="<%= favorite ? 'Remove from favourites' : 'Add to favourites' %>"
              title="<%= favorite ? 'Remove from favourites' : 'Add to favourites' %>"
              data-action="click->kb-tree#toggleFavorite"
              data-kb-tree-type-param="file"
              data-kb-tree-src-param="<%= folder_index %>"
              data-kb-tree-rel-param="<%= node[:rel] %>"
              data-kb-tree-favorite-param="<%= favorite %>">
        <%= render "kb/star_icon", filled: favorite %>
      </button>
      <%= link_to display_name, file_url,
            draggable: "false",
            data: {
              turbo_frame: "kb-content",
              action: "click->kb-notes#trackFile",
              "kb-notes-file-param": node[:rel],
              "kb-notes-src-param": folder_index,
            },
            class: "kb-file-link #{active ? 'is-active' : ''}" %>
    </div>
  <% elsif node[:type] == :download %>
    <%= render "kb/download_row", download: node[:download] %>
  <% elsif node[:type] == :job %>
    <%= render "kb/job_row", job: node[:job] %>
  <% end %>
<% end %>
