<turbo-frame id="kb-content">
  <%= form_with url: kb_fs_save_path, method: :patch, class: "kb-editor", data: { controller: "kb-selection-menu", kb_selection_menu_file_value: @selected_file, kb_selection_menu_questions_url_value: settings_local_agent_questions_path, kb_selection_menu_settings_url_value: settings_local_agent_path } do |f| %>
    <%= f.hidden_field :src, value: @selected_folder_index %>
    <%= f.hidden_field :file, value: @selected_file %>
    <div class="kb-editor-toolbar">
      <span class="kb-editor-filename"><%= File.basename(@selected_file) %></span>
      <div class="kb-editor-actions">
        <%= link_to "Cancel", kb_file_path(src: @selected_folder_index, file: @selected_file),
              data: { turbo_frame: "kb-content" }, class: "btn btn-sm" %>
        <%= f.submit "Save", class: "btn btn-sm btn-primary" %>
      </div>
    </div>
    <%= f.text_area :content, value: @raw_content, class: "kb-editor-textarea",
          autofocus: true, spellcheck: false %>
  <% end %>
</turbo-frame>
