<% open = local_assigns.fetch(:open, true) %>
<%# Selectable, time-coded transcript; driven by kb_transcript_controller.js on the parent. Collapsible (remembered per viewer). %>
<section class="kb-transcript<%= " is-open" if open %>" aria-label="Transcript"
         data-controller="kb-collapse" data-kb-collapse-key-value="kb:transcript:open" data-kb-collapse-open-value="<%= open %>">
  <div class="kb-transcript__bar">
    <h3 class="kb-transcript__title">
      <button type="button" class="kb-transcript__toggle" aria-expanded="<%= open %>"
              data-kb-collapse-target="toggle" data-action="kb-collapse#toggle">Transcript</button>
    </h3>
    <span class="kb-transcript__status" role="status" aria-live="polite" data-kb-transcript-target="status"></span>
    <button type="button" class="btn btn-sm" hidden data-kb-transcript-target="button" data-action="kb-transcript#transcribe">Transcribe</button>
  </div>
  <div class="kb-transcript__body" data-kb-collapse-target="body"<%= " hidden" unless open %>>
    <ol class="kb-transcript__list" hidden data-kb-transcript-target="list"></ol>
  </div>
</section>
