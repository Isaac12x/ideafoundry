<% project = @project %>
<%# The stage drives the page: order, which sections start open, and which one leads. %>
<% mode = project.stage_mode %>
<% plan = {
  "frame"    => { order: %w[brief materials tests findings conclusion links], open: %w[brief],
                  hint: "Pin down the question before collecting anything." },
  "research" => { order: %w[materials findings brief tests conclusion links], open: %w[materials findings],
                  hint: "Collect and sort what you read. Write findings down as you go." },
  "test"     => { order: %w[tests findings materials brief conclusion links], open: %w[tests findings],
                  hint: "Run the tests, log every run, then set a verdict on each." },
  "conclude" => { order: %w[conclusion summary results materials tests brief findings links], open: %w[conclusion summary results],
                  hint: "Write the answer to the goal, then close the project." }
}[mode] %>
<%# Every form posts src+path so the server re-resolves inside the source. %>
<% ids = capture do %><%= hidden_field_tag :src, @src, id: nil %><%= hidden_field_tag :path, project.rel, id: nil %><% end %>
<% status_tones = { "active" => "success", "paused" => "warning", "concluded" => "muted" } %>
<div class="kbp kbp--<%= mode %>" data-controller="kb-project kb-materials" data-kb-materials-key-value="<%= project.rel %>"
     data-kb-project-key-value="<%= @src %>:<%= project.rel %>" data-action="submit->kb-project#remember">
  <header class="kbp-head">
    <div class="kbp-eyebrow"><span><%= mode == "conclude" ? "Project report" : "Project" %></span>
      <span class="kbp-eyebrow-sep" aria-hidden="true"></span>
      <%= form_with url: kb_project_path, method: :patch, class: "kbp-inline" do %>
        <%= ids %>
        <%= hidden_field_tag :private, project.private? ? "1" : "0", id: nil %>
        <button type="button" class="kbp-private <%= 'is-private' if project.private? %>"
                data-next="<%= project.private? ? '0' : '1' %>"
                data-action="click->kb-project#togglePrivate"
                title="<%= project.private? ? 'Private: hidden from AI, agents and extraction. Click to change.' : 'Not private. Click to make private.' %>">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><% if project.private? %><path d="M8 11V7a4 4 0 018 0v4"/><% else %><path d="M8 11V7a4 4 0 017.5-1.9"/><% end %></svg>
          <%= project.private? ? "Private" : "Not private" %>
        </button>
      <% end %>
      <%= form_with url: kb_project_path, method: :patch, class: "kbp-inline" do %>
        <%= ids %>
        <select name="status" class="kbp-pill kbp-status" aria-label="Status" data-tone="<%= status_tones[project.status] %>"
                data-controller="select-menu" data-action="change->kb-project#submit">
          <% Kb::Project::STATUSES.each do |status| %>
            <%= tag.option status.capitalize, value: status, selected: status == project.status, data: { tone: status_tones[status] } %>
          <% end %>
        </select>
      <% end %>
      <% if project.status == "concluded" && project.concluded_on %>
        <span class="kbp-concluded">Concluded <time datetime="<%= project.concluded_on.iso8601 %>"><%= project.concluded_on.strftime("%-d %B %Y") %></time></span>
      <% end %>
      <% if mode == "conclude" %>
        <span class="kbp-tools">
          <button type="button" class="kbp-link" data-action="kb-project#copyReport" data-markdown="<%= kb_report_markdown(project) %>" aria-live="polite">Copy as markdown</button>
          <button type="button" class="kbp-link" data-action="kb-project#print">Print</button>
        </span>
      <% end %>
    </div>
    <h1 class="kbp-title"><%= project.name %></h1>
    <%= form_with url: kb_project_path, method: :patch, class: "kbp-goal-form" do %>
      <%= ids %>
      <input type="text" name="goal" value="<%= project.goal %>" class="kbp-goal" autocomplete="off"
             placeholder="Goal: what am I trying to find out?" aria-label="Goal"
             data-action="change->kb-project#submit">
    <% end %>
    <% todo = kb_project_next(project, @entries, mode) %>
    <% unsettled = mode == "conclude" ? kb_unsettled_tests(project) : [] %>
    <% todo = [] if project.status == "concluded" %>
    <% if todo.any? || unsettled.any? %>
      <p class="kbp-todo">
        <% if todo.any? %><span class="kbp-todo-label">Next</span>
          <% todo.each do |item| %><a href="#<%= item[:target] %>" class="kbp-todo-item" data-target="<%= item[:target] %>" data-action="kb-project#jump"><%= item[:label] %></a><% end %><% end %>
        <% if unsettled.any? %><span class="kbp-todo-warn"><a href="#kbp-sec-results" class="kbp-todo-item" data-target="kbp-sec-results" data-action="kb-project#jump"><%= pluralize(unsettled.size, "test") %> without a verdict</a> will show as open in the report.</span><% end %>
      </p>
    <% end %>
    <%= render "kb/projects/stage_rail", project: project, ids: ids, hint: plan[:hint] %>
  </header>


  <% plan[:order].each_with_index do |id, i| %>
    <% if mode == "conclude" && id == "materials" %><p class="kbp-appendix">Appendix</p><% end %>
    <%= render "kb/projects/sec_#{id}", project: project, ids: ids, mode: mode, lead: i.zero?, open: plan[:open].include?(id) %>
  <% end %>

  <% if mode == "conclude" %>
    <footer class="kbp-colophon">
      <span class="kbp-end" aria-hidden="true"></span>
      <% tests = project.tests %>
      <p><%= project.status == "concluded" ? "End of report." : "Draft report." %>
        <%= pluralize(tests.size, "test") %>, <%= pluralize(tests.sum { |t| t.runs.size }, "run") %>, <%= pluralize(project.all_findings.sum { |g| g[:items].size }, "finding") %>.</p>
    </footer>
  <% end %>
</div>
