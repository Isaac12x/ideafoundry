<div class="kbp-measure">
  <input type="text" name="measurements[][name]" value="<%= m["name"] %>" placeholder="name" aria-label="Measurement name" class="kbp-input" autocomplete="off">
  <input type="text" name="measurements[][value]" value="<%= m["value"] %>" placeholder="value" aria-label="Value" class="kbp-input kbp-input--num" inputmode="decimal" autocomplete="off">
  <input type="text" name="measurements[][unit]" value="<%= m["unit"] %>" placeholder="unit" aria-label="Unit" class="kbp-input kbp-input--unit" autocomplete="off">
  <button type="button" class="kbp-x" aria-label="Remove measurement" data-action="kb-project#removeMeasure">&times;</button>
</div>
