<%# Opened from "Lock with password" in the eyebrow; sits under the title and goal, not between the pills and the title. %>
<%= form_with url: kb_project_lock_path, method: :post, id: "kbp-lockpanel", class: "kbp-lockpanel",
              html: { hidden: true }, data: { action: "keydown.esc->kb-project#closeLock" } do %>
  <%= ids %>
  <p class="kbp-lock-note">Everything in this project, including its media history, becomes one encrypted archive that runs in the background. Lose the password, lose the project.</p>
  <div class="kbp-lock-fields">
    <label class="kbp-lock-label" for="kbp-lock-pw">Password</label>
    <input type="password" id="kbp-lock-pw" name="password" class="kbp-lock-input" autocomplete="new-password" required minlength="<%= Kb::ProjectLock::MIN_PASSWORD %>">
    <label class="kbp-lock-label" for="kbp-lock-pw2">Repeat password</label>
    <input type="password" id="kbp-lock-pw2" name="password_confirmation" class="kbp-lock-input" autocomplete="new-password" required>
  </div>
  <div class="kbp-actions">
    <button type="submit" class="kbp-btn kbp-btn--primary">Lock project</button>
    <button type="button" class="kbp-btn" data-action="kb-project#closeLock">Cancel</button>
  </div>
<% end %>
