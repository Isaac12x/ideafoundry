<%# Shared by every project text field: the "@" results list and the Excalidraw dialog behind "Draw". %>
<ul class="idea-kb-links__options idea-mention-options kb-mention-options" role="listbox" aria-label="Mention" hidden data-idea-mention-target="list"></ul>
<div class="idea-drawings__modal hidden" data-idea-drawings-target="modal" data-action="click->idea-drawings#closeOnBackdrop">
  <div class="idea-drawings__modal-dialog" role="dialog" aria-modal="true" aria-label="Drawing">
    <div class="idea-drawings__modal-header">
      <span class="idea-drawings__modal-title">Drawing</span>
      <button type="button" class="btn btn-sm" data-modal-close>Insert &amp; close</button>
    </div>
    <div class="idea-drawings__modal-body">
      <div class="excalidraw-mount" data-idea-drawings-target="mount" data-standalone="false"></div>
    </div>
  </div>
</div>
