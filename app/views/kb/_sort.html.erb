<% sort_field = mode.split("_").first %>
<% label = { "date" => "Modified", "added" => "Added" }.fetch(sort_field, sort_field.capitalize) %>
<details class="kb-sort" id="kb-sort" data-controller="popover">
  <summary class="kb-sort-toggle" aria-label="Sort tree (<%= label %>)" title="Sort tree: <%= label %> (right-click a folder to override it)">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="15" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/></svg>
  </summary>
  <div class="kb-sort-menu"><%= render "kb/sort_menu", mode: mode, scope: "global" %></div>
</details>
