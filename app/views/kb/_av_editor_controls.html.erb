<section class="kb-media-editor__panel">
  <div class="kb-media-editor__panel-heading"><h3>Timeline</h3><output data-kb-media-editor-target="clock">00:00.000</output></div>
  <div class="kb-media-editor__timeline">
    <label><span>In</span><input name="operations[trim_start]" type="number" min="0" step="0.01" value="0" data-kb-media-editor-target="trimStart" data-action="change->kb-media-editor#seekToIn"></label>
    <button type="button" class="btn btn-sm" data-action="kb-media-editor#markIn">Mark in</button>
    <label><span>Out</span><input name="operations[trim_end]" type="number" min="0" step="0.01" value="<%= media_info[:duration].to_f.round(3) %>" data-kb-media-editor-target="trimEnd" data-action="change->kb-media-editor#validateTrim"></label>
    <button type="button" class="btn btn-sm" data-action="kb-media-editor#markOut">Mark out</button>
  </div>
  <input class="kb-media-editor__scrubber" type="range" min="0" max="<%= media_info[:duration].to_f %>" step="0.01" value="0" data-kb-media-editor-target="scrubber" data-action="input->kb-media-editor#scrub">
</section>

<section class="kb-media-editor__panel">
  <h3>Timing & sound</h3>
  <label class="kb-media-editor__range"><span>Speed <output data-kb-media-editor-target="speedOutput">1×</output></span><input name="operations[speed]" type="range" min="0.5" max="2" step="0.05" value="1" data-kb-media-editor-target="speed"></label>
  <label class="kb-media-editor__range"><span>Volume <output data-kb-media-editor-target="volumeOutput">100%</output></span><input name="operations[volume]" type="range" min="0" max="2" step="0.05" value="1" data-kb-media-editor-target="volume"></label>
  <div class="kb-media-editor__two-up">
    <label class="kb-media-editor__field"><span>Fade in (s)</span><input name="operations[fade_in]" type="number" min="0" step="0.1" value="0"></label>
    <label class="kb-media-editor__field"><span>Fade out (s)</span><input name="operations[fade_out]" type="number" min="0" step="0.1" value="0"></label>
  </div>
  <label class="kb-media-editor__check"><input name="operations[normalize]" type="checkbox" value="1"> Normalise loudness</label>
  <% if kind == :audio %><label class="kb-media-editor__check"><input name="operations[mono]" type="checkbox" value="1"> Mix down to mono</label><% end %>
  <% if kind == :video %><label class="kb-media-editor__check"><input name="operations[mute]" type="checkbox" value="1" data-kb-media-editor-target="mute"> Remove audio</label><% end %>
</section>

<% if kind == :video %>
  <section class="kb-media-editor__panel">
    <h3>Frame</h3>
    <label class="kb-media-editor__field"><span>Crop</span><select name="operations[crop_aspect]" data-kb-media-editor-target="cropAspect"><option value="original">Original</option><option>16:9</option><option>9:16</option><option>1:1</option><option>4:3</option></select></label>
    <label class="kb-media-editor__field"><span>Rotate</span><select name="operations[rotate]" data-kb-media-editor-target="rotate"><option value="0">None</option><option value="90">90° right</option><option value="180">180°</option><option value="270">90° left</option></select></label>
    <div class="kb-media-editor__two-up"><label class="kb-media-editor__check"><input name="operations[flip_horizontal]" type="checkbox" value="1" data-kb-media-editor-target="flipHorizontal"> Flip H</label><label class="kb-media-editor__check"><input name="operations[flip_vertical]" type="checkbox" value="1" data-kb-media-editor-target="flipVertical"> Flip V</label></div>
    <label class="kb-media-editor__field"><span>Output</span><select name="operations[resolution]"><option value="original">Original resolution</option><option value="1080">1080p</option><option value="720">720p</option><option value="480">480p</option></select></label>
  </section>

  <section class="kb-media-editor__panel">
    <h3>Grade</h3>
    <label class="kb-media-editor__range"><span>Brightness <output data-kb-media-editor-target="brightnessOutput">0</output></span><input name="operations[brightness]" type="range" min="-1" max="1" step="0.01" value="0" data-kb-media-editor-target="brightness"></label>
    <label class="kb-media-editor__range"><span>Contrast <output data-kb-media-editor-target="contrastOutput">1</output></span><input name="operations[contrast]" type="range" min="0" max="2" step="0.01" value="1" data-kb-media-editor-target="contrast"></label>
    <label class="kb-media-editor__range"><span>Saturation <output data-kb-media-editor-target="saturationOutput">1</output></span><input name="operations[saturation]" type="range" min="0" max="3" step="0.01" value="1" data-kb-media-editor-target="saturation"></label>
    <label class="kb-media-editor__check"><input name="operations[grayscale]" type="checkbox" value="1" data-kb-media-editor-target="grayscale"> Black & white</label>
  </section>
<% end %>
