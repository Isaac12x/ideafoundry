<section class="kb-media-editor__panel">
  <h3>Pages</h3>
  <p class="kb-media-editor__hint"><%= media_info[:page_count].to_i.positive? ? pluralize(media_info[:page_count], "page") : "Page count unavailable" %>. Keep, remove, and reorder pages with a sequence such as <code>1-3 5 8-end</code>.</p>
  <label class="kb-media-editor__field"><span>Page sequence</span><input name="operations[page_sequence]" type="text" value="1-end" pattern="(?:\d+|end)(?:-(?:\d+|end))?(?:\s+(?:\d+|end)(?:-(?:\d+|end))?)*" required></label>
  <label class="kb-media-editor__field"><span>Rotate pages</span><select name="operations[pdf_rotation]"><option value="0">None</option><option value="90">90° right</option><option value="180">180°</option><option value="270">90° left</option></select></label>
</section>
<section class="kb-media-editor__panel">
  <h3>Output</h3>
  <label class="kb-media-editor__field"><span>Optimisation</span><select name="operations[pdf_quality]"><option value="lossless">Lossless</option><option value="print">Print</option><option value="ebook">Screen / ebook</option><option value="screen">Smallest file</option></select></label>
  <p class="kb-media-editor__hint">The original PDF remains available in revision history after saving.</p>
</section>
