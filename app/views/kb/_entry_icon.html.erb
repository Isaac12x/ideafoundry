<%
  icon_preference = if preference&.custom_icon?
    preference
  elsif default_preference&.custom_icon?
    default_preference
  end
%>
<span class="kb-entry-icon <%= 'kb-entry-icon--custom' if icon_preference %>">
  <% if icon_preference&.icon_kind == "image" && icon_preference.icon_image.attached? %>
    <%= image_tag icon_preference.icon_image, alt: "", draggable: false %>
  <% elsif icon_preference&.icon_kind == "emoji" %>
    <span aria-hidden="true"><%= icon_preference.emoji %></span>
  <% elsif fallback == "drive" %>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="8" rx="1"/><line x1="6" y1="8" x2="6.01" y2="8"/><rect x="2" y="14" width="20" height="6" rx="1"/><line x1="6" y1="17" x2="6.01" y2="17"/></svg>
  <% else %>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
  <% end %>
</span>
