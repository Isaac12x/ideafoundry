<%# Related entries for one file: bidirectional, stored as KbLink rows. src = source index, rel = file path. %>
<% related = kb_related_peers(src, rel) %>
<div id="kb-related" class="kb-related" data-controller="kb-related"
     data-kb-related-search-url-value="<%= ideas_kb_link_search_path %>">
  <details class="kb-related__add" data-controller="popover" data-kb-related-target="details" data-action="toggle->kb-related#opened">
    <summary class="kb-related__trigger" aria-label="Related entries<%= ", #{related.size} linked" if related.any? %>. Add one" title="Link entries that belong together">
      Related<% if related.any? %> <span class="kb-related__count"><%= related.size %></span><% end %> <span aria-hidden="true">+</span>
    </summary>
    <%= form_with url: kb_related_links_path, class: "kb-related__pop", data: { kb_related_target: "form" } do %>
      <%= hidden_field_tag :src, src %>
      <%= hidden_field_tag :path, rel %>
      <%= hidden_field_tag :peer_src, "", data: { kb_related_target: "peerSrc" } %>
      <%= hidden_field_tag :peer_path, "", data: { kb_related_target: "peerPath" } %>
      <input type="search" class="kb-related__input" placeholder="Find an entry to link…" autocomplete="off"
             aria-label="Find an entry to relate" data-kb-related-target="input" data-action="input->kb-related#search">
      <ul class="kb-related__results" role="listbox" data-kb-related-target="results" hidden></ul>
      <p class="kb-related__hint">Link entries that belong together. To put one file in several folders, use “Also in another folder…” on the tree instead.</p>
    <% end %>
  </details>
  <% if related.any? %>
    <ul class="kb-related__list" aria-label="Related entries">
      <% related.each do |peer| %>
        <li class="kb-related__item<%= ' is-missing' if peer.kind == :missing %>">
          <% case peer.kind %>
          <% when :missing %>
            <span title="This entry no longer exists"><%= peer.rel %></span>
          <% when :file %>
            <%= link_to peer.rel, kb_file_path(src: peer.src, file: peer.rel), title: peer.rel, data: { turbo_frame: "kb-content" } %>
          <% else %>
            <%= link_to "#{peer.rel}/", kb_path(src: peer.src, folder: peer.rel), title: peer.rel %>
          <% end %>
          <%= button_to kb_related_link_path(peer.link), method: :delete, class: "kb-related__remove",
                form: { class: "kb-related__form" }, "aria-label": "Remove related link to #{peer.rel}", title: "Remove link" do %>×<% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
